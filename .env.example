# 모델 프로바이더 설정: 기본적으로 llama.cpp 사용 (Gemini, vLLM 미사용)
MODEL_PROVIDER="llamacpp"

# llama.cpp 서버 로컬 접속용 주소 (GPU 서버 포트포워딩 연동)
# 예: ssh -p 30543 -L 8088:127.0.0.1:8088 root@112.217.124.195
LLAMACPP_BASE_URL="http://127.0.0.1:8088"
LLAMACPP_MODEL="qwen3-8b-v4-lora-llamacpp"

# llama.cpp 텍스트 생성 하이퍼파라미터 설정
LLAMACPP_MAX_TOKENS="1400"
LLAMACPP_REPEAT_PENALTY="1.12"
LLAMACPP_FREQUENCY_PENALTY="0.25"
LLAMACPP_TOP_K="20"
LLAMACPP_MIN_P="0.05"

# llama.cpp 실시간 LoRA 스위칭 기능 제어
# llama-server를 실행할 때 적용할 어댑터들을 미리 순서대로 마운트해두어야 합니다.
LLAMACPP_LORA_RUNTIME_SWITCH="true"
LLAMACPP_LORA_DEBUG="false"
LLAMACPP_LORA_SCALE="1"

# 각 작가 페르소나별 라마 서버 LoRA 로드 인덱스 ID 매핑 (0, 1, 2, 3)
LLAMACPP_LORA_DEFAULT_ID="0"
LLAMACPP_LORA_GAME_ID="1"
LLAMACPP_LORA_NOVEL_ID="2"
LLAMACPP_LORA_MOVIE_ID="3"
LLAMACPP_LORA_AD_ID="0"

# 애플리케이션 호스팅 기본 URL (인증/콜백 처리용)
APP_URL="MY_APP_URL"
