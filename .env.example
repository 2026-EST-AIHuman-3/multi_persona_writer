# MODEL_PROVIDER: llamacpp is the default for the local/GPU scenario writer flow.
# Supported: llamacpp, vllm, gemini
MODEL_PROVIDER="llamacpp"

# LLAMACPP_BASE_URL: Use an SSH tunnel from the GPU server to expose llama.cpp locally.
# Example:
# ssh -p 30543 -L 8088:127.0.0.1:8088 root@112.217.124.195
LLAMACPP_BASE_URL="http://127.0.0.1:8088"
LLAMACPP_MODEL="qwen3-8b-v4-lora-llamacpp"
LLAMACPP_MAX_TOKENS="1400"
LLAMACPP_REPEAT_PENALTY="1.12"
LLAMACPP_FREQUENCY_PENALTY="0.25"
LLAMACPP_TOP_K="20"
LLAMACPP_MIN_P="0.05"

# llama.cpp runtime LoRA switching.
# Start llama-server with all persona adapters loaded and not applied:
# llama-server -m BASE.gguf --lora game.gguf,movie.gguf,novel.gguf,ad.gguf --lora-init-without-apply ...
# Then the app calls POST /lora-adapters before each generation.
LLAMACPP_LORA_RUNTIME_SWITCH="true"
LLAMACPP_LORA_SCALE="1"
LLAMACPP_LORA_DEFAULT_ID="0"
LLAMACPP_LORA_50_ID="0"
LLAMACPP_LORA_500_ID="1"
LLAMACPP_LORA_GAME_ID="1"
LLAMACPP_LORA_MOVIE_ID=""
LLAMACPP_LORA_NOVEL_ID=""
LLAMACPP_LORA_AD_ID=""

# VLLM_BASE_URL: Use an SSH tunnel from the GPU server to expose vLLM locally.
# Example:
# ssh -p 30543 -L 8000:127.0.0.1:8000 root@112.217.124.195
# On the GPU server, vLLM LoRA serving should be launched with:
# vllm serve Qwen/Qwen3-8B --host 127.0.0.1 --port 8000 --enable-lora --lora-modules qwen3-8b-game-lora=/path/to/adapter
VLLM_BASE_URL="http://127.0.0.1:8000"
VLLM_API_KEY=""
VLLM_MODEL="qwen3-8b-game-lora"
VLLM_MODEL_GAME="qwen3-8b-game-lora"
VLLM_MODEL_MOVIE=""
VLLM_MODEL_NOVEL=""
VLLM_MODEL_AD=""
VLLM_MAX_TOKENS="1400"
VLLM_REPETITION_PENALTY="1.12"
VLLM_FREQUENCY_PENALTY="0.25"
VLLM_TOP_K="20"
VLLM_MIN_P="0.05"

# GEMINI_API_KEY: Optional fallback if MODEL_PROVIDER="gemini".
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
