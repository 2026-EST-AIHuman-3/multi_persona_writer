text-secondary\">\355\231\234\354\204\261\355\231\224\353\220\234 \355\216\230\353\245\264\354\206\214\353\202\230: Noir Detective V4</span>\n            <span className=\"text-muted-text\">352 words</span>\n          </div>\n        </div>\n\n        {/* Floating Persona Cards */}\n        <motion.div \n          animate={{ y: [0, -6, 0] }}\n          transition={{ duration: 4, repeat: Infinity, ease: \"easeInOut\" }}\n          className=\"absolute z-30 top-10 -left-10 bg-surface-warm border border-primary rounded p-3 shadow-md transform -rotate-3 w-48\"\n        >\n          <div className=\"flex items-center gap-2 mb-2\">\n            <Gamepad2 className=\"text-primary\" size={16} />\n            <span className=\"font-sans text-xs font-bold text-on-surface\">\352\262\214\354\236\204 \353\235\274\354\235\264\355\204\260</span>\n          </div>\n          <div className=\"font-mono text-[10px] text-secondary bg-secondary bg-opacity-10 px-2 py-0.5 rounded inline-block\">\n            LoRA: RPG_Quest_Gen\n          </div>\n        </motion.div>\n\n        <motion.div \n          animate={{ y: [0, 8, 0] }}\n          transition={{ duration: 5, repeat: Infinity, ease: \"easeInOut\", delay: 0.5 }}\n          className=\"absolute z-10 bottom-20 -right-4 bg-surface-warm border border-border-warm rounded p-3 shadow-sm transform rotate-6 w-48 opacity-80 hover:opacity-100 transition-opacity\"\n        >\n          <div className=\"flex items-center gap-2 mb-2\">\n            <Film className=\"text-tertiary\" size={16} />\n            <span className=\"font-sans text-xs font-bold text-on-surface\">\354\230\201\355\231\224 \353\214\200\353\263\270</span>\n          </div>\n          <div className=\"font-mono text-[10px] text-tertiary bg-tertiary bg-opacity-10 px-2 py-0.5 rounded inline-block\">\n            LoRA: Screenplay_Format\n          </div>\n        </motion.div>\n\n        {/* Evaluation Match Meter Float */}\n        <motion.div \n          initial={{ scale: 0.9,