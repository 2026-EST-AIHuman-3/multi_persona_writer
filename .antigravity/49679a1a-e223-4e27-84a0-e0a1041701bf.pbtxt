  file_change {
    absolute_path_uri: "file:///src/components/ArchiveView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState } from \"react\";\nimport { Search, Filter, BookOpen, Film, Gamepad2, Mega, ArrowUpRight } from \"lucide-react\";\nimport { Manuscript, ManuscriptStatus, Persona } from \"../types\";\n\ninterface ArchiveViewProps {\n  manuscripts: Manuscript[];\n  personas: Persona[];\n  onSelectManuscript: (manuscript: Manuscript) => void;\n}\n\nexport default function ArchiveView({ manuscripts, personas, onSelectManuscript }: ArchiveViewProps) {\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [activeCategory, setActiveCategory] = useState<\"all\" | \"novel\" | \"script\" | \"other\">(\"all\");\n\n  const getPersonaBadge = (personaId: string) => {\n    const p = personas.find(x => x.id === personaId);\n    if (!p) return { name: \"\354\225\214 \354\210\230 \354\227\206\354\235\214\", icon: <BookOpen size={12} /> };\n    \n    let icon = <BookOpen size={12} />;\n    if (p.icon === \'game\') icon = <Gamepad2 size={12} />;\n    else if (p.icon === \'movie\') icon = <Film size={12} />;\n    else if (p.icon === \'ad\') icon = <Mega size={12} />;\n\n    return { name: p.name, icon };\n  };\n\n  const getStatusColor = (status: ManuscriptStatus) => {\n    switch (status) {\n      case \"completed\":\n        return { bg: \"bg-success\", text: \"\354\231\204\353\243\214\353\220\250\" };\n      case \"draft\":\n        return { bg: \"bg-warning\", text: \"\354\264\210\354\225\210 \354\236\221\354\204\261 \354\244\221\" };\n      case \"editing\":\n        return { bg: \"bg-secondary\", text: \"\354\210\230\354\240\225 \354\244\221\" };\n      default:\n        return { bg: \"bg-outline\", text: \"\354\247\204\355\226\211 \354\244\221\" };\n    }\n  };\n\n  // Filtering manuscripts\n  const filteredManuscripts = manuscripts.filter((m) => {\n    // Search filter\n    const matchesSearch = \n      m.title.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      m.content.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      m.prompt.toLowerCase().includes(searchTerm.toLowerCase());\n\n    if (!matchesSearch) return false;\n\n    // Category filter\n    if (activeCategory === \"all\") return true;\n    if (activeCategory === \"novel\") return m.personaId === \"novel\";\n    if (activeCategory === \"script\") return m.personaId === \"movie\" || m.personaId === \"game\";\n    if (activeCategory === \"other\") return m.personaId === \"ad\";\n\n    return true;\n  });\n\n  return (\n    <div className=\"flex-1 ml-0 md:ml-sidebar-width bg-surface-warm px-margin-page py-8 flex flex-col min-h-full overflow-y-auto\">\n      {/* Page Header & Search */}\n      <div className=\"max-w-[1000px] w-full mx-auto mb-10 flex flex-col gap-6\">\n        <h1 className=\"font-headline-xl text-headline-xl text-on-surface font-semibold tracking-tight\">\354\233\220\352\263\240 \354\225\204\354\271\264\354\235\264\353\270\214</h1>\n        <div className=\"flex flex-col md:flex-row gap-4 items-center justify-between border-b border-border-warm pb-4\">\n          \n          {/* Search Bar */}\n          <div className=\"relative w-full md:w-96 flex items-center\">\n            <Search className=\"absolute left-3 text-outline\" size={16} />\n            <input \n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              className=\"w-full bg-transparent border-none focus:outline-none focus:ring-0 text-on-surface pl-10 pr-4 py-2 placeholder-outline-variant text-sm\" \n              placeholder=\"\354\233\220\352\263\240 \352\262\200\354\203\211...\" \n              type=\"text\"\n            />\n          </div>\n\n          {/* Filters */}\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <button \n              onClick={() => setActiveCategory(\"all\")}\n              className={`px-4 py-1.5 rounded-full border text-xs font-medium cursor-pointer transition-colors ${\n                activeCategory === \"all\"\n                  ? \"border-primary bg-primary-container text-on-primary-container\"\n                  : \"border-border-warm text-on-surface-variant hover:border-outline hover:text-on-surface\"\n              }`}\n            >\n              \353\252\250\353\223\240 \355\224\204\353\241\234\354\240\235\355\212\270\n            </button>\n            <button \n              onClick={() => setActiveCategory(\"novel\")}\n              className={`px-4 py-1.5 rounded-full border text-xs font-medium cursor-pointer transition-colors ${\n                activeCategory === \"novel\"\n                  ? \"border-primary bg-primary-container text-on-primary-container\"\n                  : \"border-border-warm text-on-surface-variant hover:border-outline hover:text-on-surface\"\n              }`}\n            >\n              \354\206\214\354\204\244\n            </button>\n            <button \n              onClick={() => setActiveCategory(\"script\")}\n              className={`px-4 py-1.5 rounded-full border text-xs font-medium cursor-pointer transition-colors ${\n                activeCategory === \"script\"\n                  ? \"border-primary bg-primary-container text-on-primary-container\"\n                  : \"border-border-warm text-on-surface-variant hover:border-outline hover:text-on-surface\"\n              }`}\n            >\n              \354\213\234\353\202\230\353\246\254\354\230\244\n            </button>\n            <button \n              onClick={() => setActiveCategory(\"other\")}\n              className={`px-4 py-1.5 rounded-full border text-xs font-medium cursor-pointer transition-colors flex items-center gap-1 ${\n                activeCategory === \"other\"\n                  ? \"border-primary bg-primary-container text-on-primary-container\"\n                  : \"border-border-warm text-on-surface-variant hover:border-outline hover:text-on-surface\"\n              }`}\n            >\n              <Filter size={12} />\n              \352\264\221\352\263\240/\352\270\260\355\203\200\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Bento Grid Archive List */}\n      <div className=\"max-w-[1000px] w-full mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-stack-gap pb-20\">\n        {filteredManuscripts.length === 0 ? (\n          <div className=\"col-span-full py-20 text-center text-on-surface-variant opacity-60\">\n            <p>\352\262\200\354\203\211 \354\241\260\352\261\264\354\227\220 \353\247\236\353\212\224 \354\233\220\352\263\240\353\245\274 \354\260\276\354\247\200 \353\252\273\355\226\210\354\212\265\353\213\210\353\213\244.</p>\n            <p className=\"text-xs mt-1\">\354\203\210 \354\233\220\352\263\240 \353\262\204\355\212\274\354\235\204 \355\201\264\353\246\255\355\225\264 \354\262\253 \352\270\200\354\236\221\354\204\261\354\235\204 \354\213\234\354\236\221\355\225\264\353\263\264\354\204\270\354\232\224.</p>\n          </div>\n        ) : (\n          filteredManuscripts.map((m, index) => {\n            const isFirst = index === 0;\n            const badge = getPersonaBadge(m.personaId);\n            const status = getStatusColor(m.status);\n\n            return (\n              <div \n                key={m.id}\n                onClick={() => onSelectManuscript(m)}\n                className={`bg-surface border border-border-warm rounded-lg p-6 flex flex-col justify-between group hover:border-primary transition-all cursor-pointer min-h-[220px] ${\n                  isFirst ? \"lg:col-span-2 shadow-sm\" : \"\"\n                }`}\n              >\n                <div className=\"flex justify-between items-start mb-4\">\n                  <div className=\"flex items-center gap-2 text-outline text-xs\">\n                    <span className={`w-2.5 h-2.5 rounded-full ${status.bg}`}></span>\n                    {status.text} \302\267 {m.createdAt}\n                  </div>\n                  {isFirst && (\n                    <ArrowUpRight className=\"text-outline-variant group-hover:text-primary transition-colors\" size={16} />\n                  )}\n                </div>\n\n                <div className=\"flex-grow\">\n                  <h3 className={`text-on-surface font-semibold mb-2 group-hover:text-primary transition-colors ${\n                    isFirst ? \"text-xl\" : \"text-base\"\n                  }`}>\n                    {m.title}\n                  </h3>\n                  <p className=\"text-on-surface-variant text-sm line-clamp-2 mb-6\">\n                    {m.content || \"\353\271\210 \353\202\264\354\232\251\354\235\230 \354\225\204\354\271\264\354\235\264\353\270\214\353\220\234 \354\233\220\352\263\240\354\236\205\353\213\210\353\213\244.\"}\n                  </p>\n                </div>\n\n                <div className=\"flex flex-wrap items-center gap-2 mt-auto pt-2 border-t border-border-warm/50\">\n                  <span className=\"bg-surface-container px-2.5 py-1 rounded border border-border-warm text-xs font-medium text-on-surface flex items-center gap-1.5\">\n                    {badge.icon} {badge.name}\n                  </span>\n                  <span className=\"bg-secondary-container bg-opacity-20 px-2.5 py-1 rounded text-secondary text-xs font-mono border border-secondary border-opacity-10\">\n                    {m.loraAdapter}\n                  </span>\n                  {m.wordCount > 0 && (\n                    <span className=\"text-on-surface-variant text-[11px] ml-auto font-medium\">\n                      {m.wordCount.toLocaleString()} \353\213\250\354\226\264\n                    </span>\n                  )}\n                </div>\n              </div>\n            );\n          })\n        )}\n      </div>\n\n      {/* Embedded Simple Footer inside archive page */}\n      <footer className=\"mt-auto max-w-[1000px] w-full mx-auto text-xs bg-bg-warm text-on-surface border-t border-border-warm py-12 px-margin-page flex flex-col md:flex-row justify-between items-center gap-stack-gap\">\n        <div className=\"font-sans text-headline-sm text-primary font-bold\">\n          Persona Writer Studio\n        </div>\n        <div className=\"text-muted-text text-center md:text-left\">\n          \302\251 2026 Persona Writer Studio. Editorial AI Craft.\n        </div>\n        <div className=\"flex gap-6\">\n          <a className=\"text-muted-text hover:text-primary transition-colors opacity-80\" href=\"#privacy\">\352\260\234\354\235\270\354\240\225\353\263\264 \354\262\230\353\246\254\353\260\251\354\271\250</a>\n          <a className=\"text-muted-text hover:text-primary transition-colors opacity-80\" href=\"#tos\">\354\235\264\354\232\251\354\225\275\352\264\200</a>\n          <a className=\"text-muted-text hover:text-primary transition-colors opacity-80\" href=\"#api\">API \353\254\270\354\204\234</a>\n        </div>\n      </footer>\n    </div>\n  );\n}\n"
