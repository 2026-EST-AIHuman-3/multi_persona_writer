    instruction: "Restyle the Create Persona modal in App.tsx to use Editorial Aesthetic (square corners, uppercase tracking, mono headers, and minimalist buttons)."
    replacement_infos {
      original_chunk {
        target_content: "      {/* Dynamic Persona Creator Dialog / Modal */}\n      {showCreatePersonaModal && (\n        <div className=\"fixed inset-0 bg-panel-dark/60 backdrop-blur-xs flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-surface-warm border border-border-warm rounded-lg shadow-xl max-w-md w-full overflow-hidden\">\n            <div className=\"p-6 border-b border-border-warm flex justify-between items-center bg-background\">\n              <h3 className=\"font-sans text-lg font-bold text-ink\">\354\203\210 \354\236\221\352\260\200 \355\216\230\353\245\264\354\206\214\353\202\230 \353\247\214\353\223\244\352\270\260</h3>\n              <button \n                onClick={() => setShowCreatePersonaModal(false)}\n                className=\"text-on-surface-variant hover:text-primary transition-colors cursor-pointer\"\n              >\n                <X size={20} />\n              </button>\n            </div>\n            \n            <form onSubmit={handleCreatePersonaSubmit} className=\"p-6 space-y-4\">\n              <div>\n                <label className=\"block text-xs font-semibold text-on-surface-variant mb-1 font-mono\">\354\236\221\352\260\200\353\252\205 (Persona Name)</label>\n                <input \n                  required\n                  value={newPersonaName}\n                  onChange={(e) => setNewPersonaName(e.target.value)}\n                  type=\"text\" \n                  className=\"w-full bg-surface border border-border-warm rounded p-2 focus:ring-1 focus:ring-primary text-sm\"\n                  placeholder=\"\354\230\210: SF \355\225\230\353\223\234 \354\236\245\353\245\264 \354\206\214\354\204\244\352\260\200, \355\230\204\353\214\200 \352\260\200\354\240\204 \353\247\210\354\274\200\355\204\260\"\n                />\n              </div>\n \n              <div>\n                <label className=\"block text-xs font-semibold text-on-surface-variant mb-1 font-mono\">LoRA \354\226\264\353\214\221\355\204\260 \355\212\234\353\213\235 \354\240\225\353\263\264</label>\n                <input \n                  value={newPersonaAdapter}\n                  onChange={(e) => setNewPersonaAdapter(e.target.value)}\n                  type=\"text\" \n                  className=\"w-full bg-surface border border-border-warm rounded p-2 focus:ring-1 focus:ring-primary font-mono text-xs\"\n                  placeholder=\"\354\230\210: LoRA: Space_Future_0.9\"\n                />\n              </div>\n \n              <div>\n                <label className=\"block text-xs font-semibold text-on-surface-variant mb-1 font-mono font-sans\">\354\225\204\354\235\264\354\275\230 \354\212\244\355\203\200\354\235\274 \354\234\240\355\230\225</label>\n                <select \n                  value={newPersonaIcon}\n                  onChange={(e) => setNewPersonaIcon(e.target.value)}\n                  className=\"w-full bg-surface border border-border-warm rounded p-2 text-sm focus:ring-1 focus:ring-primary\"\n                >\n                  <option value=\"novel\">\354\206\214\354\204\244\352\260\200 \353\214\200\354\244\221 \353\254\270\355\225\231 (Book)</option>\n                  <option value=\"movie\">\354\230\201\355\231\224 \353\260\217 \352\267\271\354\236\221 \354\213\234\353\202\230\353\246\254\354\230\244 (Film)</option>\n                  <option value=\"game\">\352\262\214\354\236\204 \352\270\260\355\232\215 \353\260\217 \353\214\200\354\202\254 \355\212\270\353\246\254 (Game)</option>\n                  <option value=\"ad\">\353\257\270\353\224\224\354\226\264 \352\264\221\352\263\240 \354\271\264\355\224\274\353\235\274\354\235\264\355\214\205 (Ad)</option>\n                </select>\n              </div>\n \n              <div>\n                <label className=\"block text-xs font-semibold text-on-surface-variant mb-1 font-mono font-sans\">\355\216\230\353\245\264\354\206\214\353\202\230 \354\204\244\353\252\205 \353\260\217 \355\206\244 \354\240\225\354\235\230</label>\n                <textarea \n                  value={newPersonaDesc}\n                  onChange={(e) => setNewPersonaDesc(e.target.value)}\n                  className=\"w-full bg-surface border border-border-warm rounded p-2 text-sm min-h-[80px] focus:ring-1 focus:ring-primary\"\n                  placeholder=\"\354\230\210: \354\243\274\353\241\234 \354\204\234\354\210\240\354\235\264 \352\261\260\354\271\240\352\263\240 \353\224\224\355\205\214\354\235\274\355\225\234 \353\254\230\354\202\254\353\245\274 \354\247\200\355\226\245\355\225\251\353\213\210\353\213\244. \352\270\260\352\263\204\354\240\201\354\235\270 \353\254\270\353\252\205\354\235\264\353\202\230 \354\225\224\353\213\264\355\225\234 \353\217\204\354\213\234 \354\240\225\354\267\250\354\227\220 \354\225\214\353\247\236\353\212\224 \355\225\204\354\262\264\353\245\274 \354\224\201\353\213\210\353\213\244.\"\n                />\n              </div>\n \n              <div className=\"pt-4 border-t border-border-warm flex gap-3 justify-end text-xs font-semibold\">\n                <button \n                  type=\"button\"\n                  onClick={() => setShowCreatePersonaModal(false)}\n                  className=\"px-4 py-2 text-on-surface-variant hover:bg-surface-container-low rounded border border-border-warm cursor-pointer\"\n                >\n                  \354\267\250\354\206\214\n                </button>\n                <button \n                  type=\"submit\"\n                  className=\"px-6 py-2 bg-primary text-on-primary rounded hover:bg-primary/90 shadow-sm cursor-pointer\"\n                >\n                  \353\247\214\353\223\244\352\270\260\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}"
        replacement_content: "      {/* Dynamic Persona Creator Dialog / Modal */}\n      {showCreatePersonaModal && (\n        <div className=\"fixed inset-0 bg-panel-dark/80 backdrop-blur-xs flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-sheet-background border border-border-warm rounded-none max-w-md w-full overflow-hidden text-on-surface\">\n            <div className=\"p-6 border-b border-border-warm flex justify-between items-center bg-[#121212]\">\n              <div>\n                <span className=\"text-[9px] font-mono tracking-[0.4em] text-secondary uppercase font-bold block mb-1\">REGISTRATION</span>\n                <h3 className=\"font-serif italic text-lg text-ink font-semibold\">\354\203\210 \354\236\221\352\260\200 \355\216\230\353\245\264\354\206\214\353\202\230 \353\223\261\353\241\235</h3>\n              </div>\n              <button \n                onClick={() => setShowCreatePersonaModal(false)}\n                className=\"text-muted-text hover:text-primary transition-colors cursor-pointer border border-border-warm p-1.5 rounded-none\"\n              >\n                <X size={16} />\n              </button>\n            </div>\n            \n            <form onSubmit={handleCreatePersonaSubmit} className=\"p-6 space-y-4 bg-bg-warm\">\n              <div>\n                <label className=\"block text-[9px] font-bold text-muted-text mb-1.5 font-mono tracking-widest uppercase\">\354\236\221\352\260\200\353\252\205 (Persona Name)</label>\n                <input \n                  required\n                  value={newPersonaName}\n                  onChange={(e) => setNewPersonaName(e.target.value)}\n                  type=\"text\" \n                  className=\"w-full bg-[#121212] border border-border-warm rounded-none p-3 focus:outline-none focus:border-primary text-xs\"\n                  placeholder=\"\354\230\210: SF \354\236\245\353\245\264 \354\206\214\354\204\244\352\260\200, \355\230\204\353\214\200 \352\260\200\354\240\204 \353\247\210\354\274\200\355\204\260\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[9px] font-bold text-muted-text mb-1.5 font-mono tracking-widest uppercase\">LoRA \354\226\264\353\214\221\355\204\260 \355\212\234\353\213\235 \354\240\225\353\263\264</label>\n                <input \n                  value={newPersonaAdapter}\n                  onChange={(e) => setNewPersonaAdapter(e.target.value)}\n                  type=\"text\" \n                  className=\"w-full bg-[#121212] border border-border-warm rounded-none p-3 focus:outline-none focus:border-primary font-mono text-[11px]\"\n                  placeholder=\"\354\230\210: LoRA: Space_Future_0.9\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[9px] font-bold text-muted-text mb-1.5 font-mono tracking-widest uppercase\">\354\225\204\354\235\264\354\275\230 \354\212\244\355\203\200\354\235\274 \354\234\240\355\230\225</label>\n                <select \n                  value={newPersonaIcon}\n                  onChange={(e) => setNewPersonaIcon(e.target.value)}\n                  className=\"w-full bg-[#121212] border border-border-warm rounded-none p-3 text-xs focus:outline-none focus:border-primary text-on-surface\"\n                >\n                  <option value=\"novel\">\354\206\214\354\204\244\352\260\200 \353\214\200\354\244\221 \353\254\270\355\225\231 (Book)</option>\n                  <option value=\"movie\">\354\230\201\355\231\224 \353\260\217 \352\267\271\354\236\221 \354\213\234\353\202\230\353\246\254\354\230\244 (Film)</option>\n                  <option value=\"game\">\352\262\214\354\236\204 \352\270\260\355\232\215 \353\260\217 \353\214\200\354\202\254 \355\212\270\353\246\254 (Game)</option>\n                  <option value=\"ad\">\353\257\270\353\224\224\354\226\264 \352\264\221\352\263\240 \354\271\264\355\224\274\353\235\274\354\235\264\355\214\205 (Ad)</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-[9px] font-bold text-muted-text mb-1.5 font-mono tracking-widest uppercase\">\355\216\230\353\245\264\354\206\214\353\202\230 \354\204\244\353\252\205 \353\260\217 \355\206\244 \354\240\225\354\235\230</label>\n                <textarea \n                  value={newPersonaDesc}\n                  onChange={(e) => setNewPersonaDesc(e.target.value)}\n                  className=\"w-full bg-[#121212] border border-border-warm rounded-none p-3 text-xs min-h-[90px] focus:outline-none focus:border-primary leading-relaxed\"\n                  placeholder=\"\354\230\210: \354\243\274\353\241\234 \354\204\234\354\210\240\354\235\264 \352\261\260\354\271\240\352\263\240 \353\224\224\355\205\214\354\235\274\355\225\234 \353\254\230\354\202\254\353\245\274 \354\247\200\355\226\245\355\225\251\353\213\210\353\213\244...\"\n                />\n              </div>\n\n              <div className=\"pt-5 border-t border-border-warm flex gap-3 justify-end text-[10px] font-bold tracking-widest uppercase\">\n                <button \n                  type=\"button\"\n                  onClick={() => setShowCreatePersonaModal(false)}\n                  className=\"px-5 py-3 text-muted-text border border-border-warm bg-transparent hover:border-primary hover:text-primary rounded-none cursor-pointer transition-all\"\n                >\n                  \354\267\250\354\206\214\n                </button>\n                <button \n                  type=\"submit\"\n                  className=\"px-6 py-3 bg-primary border border-primary text-on-primary rounded-none hover:bg-transparent hover:text-primary cursor-pointer transition-colors\"\n                >\n                  \353\223\261\353\241\235\355\225\230\352\270\260\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}"
