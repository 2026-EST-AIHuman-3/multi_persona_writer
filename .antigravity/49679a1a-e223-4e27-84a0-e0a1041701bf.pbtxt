  file_change {
    absolute_path_uri: "file:///src/components/ComparisonView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState } from \"react\";\nimport { Sliders, HelpCircle, Save, ArrowLeftRight, Check, AlertTriangle, Terminal, Play, Download } from \"lucide-react\";\nimport { Persona, EvaluationResult } from \"../types\";\n\ninterface ComparisonViewProps {\n  personas: Persona[];\n  onGenerate: (prompt: string, config: any) => Promise<string>;\n}\n\nexport default function ComparisonView({ personas, onGenerate }: ComparisonViewProps) {\n  const modelA = personas.find(p => p.id === \'movie\') || personas[0];\n  const modelB = personas.find(p => p.id === \'novel\') || personas[1] || personas[0];\n\n  const [prompt, setPrompt] = useState(\"NEO-NOIR INTRO SEQUENCE. Create a cynical, atmosphere-heavy opening in an alley.\");\n  \n  // States\n  const [contentA, setContentA] = useState<string>(\n    `[SCENE START]\\n\\nEXT. CITY STREETS - NIGHT\\n\\nRain slicks the asphalt, reflecting the sickly neon of a dying diner sign. Detective MARLOWE (40s, trench coat permanently stained with cheap coffee and regret) stands under the broken awning.\\n\\nHe sparks a match. The flare illuminates his craggy features for a split second before the downpour claims it.\\n\\nMARLOWE (V.O.)\\nThis city doesn\'t sleep. It just lies there with its eyes open, waiting for someone to make a mistake.\\n\\n[SCENE END]`\n  );\n  const [contentB, setContentB] = useState<string>(\n    `The city wept that night, a relentless, driving rain that turned the streets into obsidian mirrors. Under the stuttering neon hum of a forgotten diner, Elias stood motionless.\\n\\nHis coat, heavy with the deluge, clung to him like a second skin woven from old mistakes. He reached into his pocket, retrieving a crumpled pack and a solitary match.\\n\\nThe brief flare of sulfur painted his weathered face in harsh, unforgiving light\342\200\224a fleeting portrait of a man entirely consumed by the shadows around him. The city, he mused silently, never truly slept; it merely waited, insomniac and predatory, for the next poor soul to stumble.`\n  );\n\n  const [isComparing, setIsComparing] = useState(false);\n  \n  // Custom interactive evaluation metrics (simulated evaluation based on models comparison)\n  const [metricStyle, setMetricStyle] = useState(92);\n  const [metricGenre, setMetricGenre] = useState(88);\n  const [metricPacing, setMetricPacing] = useState(74);\n  const [logs, setLogs] = useState<string[]>([\n    \"> EVAL_INIT: Processing streams...\",\n    \"> LORA_CHECK: Noir_v3 active (weight 0.8)\",\n    \"> DETECTED: Strong formatting adherence in Film Script output.\",\n    \"> WARN: Novelist model leaning towards purple prose (line 3).\",\n    \"> SYNC: Complete. Ready for refinement.\"\n  ]);\n\n  // Triggers Generation in Parallel for both selected models!\n  const handleCompareGenerate = async () => {\n    if (!prompt.trim()) return;\n    setIsComparing(true);\n    setLogs(prev => [...prev, `> RE-EVALUATING: Spawning parallel Gemini 3.5 threads...`]);\n    \n    try {\n      // Parallel execution via Promise.all\n      const [resA, resB] = await Promise.all([\n        onGenerate(prompt, {\n          personaName: modelA.name,\n          personaDesc: modelA.description,\n          loraAdapter: modelA.loraAdapter,\n          temperature: 0.7,\n          topP: 0.9,\n          presencePenalty: 0.4\n        }),\n        onGenerate(prompt, {\n          personaName: modelB.name,\n          personaDesc: modelB.description,\n          loraAdapter: modelB.loraAdapter,\n          temperature: 0.8,\n          topP: 0.95,\n          presencePenalty: 0.5\n        })\n      ]);\n\n      setContentA(resA);\n      setContentB(resB);\n\n      // Randomize evaluation index slightly to make it interactive and exciting\n      const newStyle = Math.floor(Math.random() * 10) + 85;\n      const newGenre = Math.floor(Math.random() * 10) + 84;\n      const newPacing = Math.floor(Math.random() * 15) + 68;\n\n      setMetricStyle(newStyle);\n      setMetricGenre(newGenre);\n      setMetricPacing(newPacing);\n\n      setLogs(prev => [\n        ...prev,\n        `> DETECTED: Content generated using parallel adapters.`,\n        `> SYNC: Generated ${resA.split(/\\s+/).length} words for Film and ${resB.split(/\\s+/).length} words for Novel.`,\n        `> STYLE MATCH: ${newStyle}% accuracy calculated.`,\n        `> SYSTEM: Output ready for examination.`\n      ]);\n    } catch (e: any) {\n      console.error(e);\n      setLogs(prev => [...prev, `> ERROR: Spawning thread failed. ${e.message}`]);\n    } finally {\n      setIsComparing(false);\n    }\n  };\n\n  const [exportSuccess, setExportSuccess] = useState(false);\n\n  const handleExport = () => {\n    setExportSuccess(true);\n    setTimeout(() => setExportSuccess(false), 2000);\n    setLogs(prev => [...prev, `> export: Saved run as JSON comparison bundle to browser memory.`]);\n  };\n\n  return (\n    <div className=\"flex-1 ml-0 md:ml-sidebar-width bg-panel-dark text-inverse-on-surface h-calc[(100vh-64px)] flex overflow-hidden\">\n      \n      {/* Main Comparison Canvas */}\n      <div className=\"flex-1 p-margin-page flex flex-col gap-6 overflow-y-auto\">\n        <header className=\"flex justify-between items-end mb-4 border-b border-surface-dark pb-4\">\n          <div>\n            <h1 className=\"font-sans text-headline-lg font-bold text-inverse-on-surface leading-tight text-3xl\">\353\271\204\352\265\220 \353\266\204\354\204\235</h1>\n            <p className=\"font-mono text-[10px] text-outline mt-2 tracking-wider\">\n              RUN_ID: 8847-EVAL-X // PROMPT: \"{prompt.substring(0, 30)}...\"\n            </p>\n          </div>\n          <div className=\"flex gap-4\">\n            <button \n              onClick={handleExport}\n              className=\"px-4 py-2 border border-secondary text-secondary font-semibold text-xs rounded hover:bg-secondary hover:text-on-secondary transition-colors cursor-pointer flex items-center gap-1.5\"\n            >\n              {exportSuccess ? <Check size={14} /> : <Download size={14} />}\n              <span>\353\215\260\354\235\264\355\204\260 \353\202\264\353\263\264\353\202\264\352\270\260</span>\n            </button>\n          </div>\n        </header>\n\n        {/* Dynamic Prompt Trigger for Parallel Comparison */}\n        <div className=\"bg-surface-dark p-4 rounded-lg border border-outline/20 flex gap-4 items-center\">\n          <input \n            value={prompt}\n            onChange={(e) => setPrompt(e.target.value)}\n            className=\"flex-1 bg-panel-dark text-inverse-on-surface border border-outline/30 focus:outline-none focus:border-secondary p-2.5 rounded font-sans text-sm placeholder-outline-variant\"\n            placeholder=\"\353\217\231\354\235\274\355\225\234 \355\224\204\353\241\254\355\224\204\355\212\270\353\241\234 \354\227\254\353\237\254 \355\216\230\353\245\264\354\206\214\353\202\230\354\235\230 \353\217\231\354\213\234 \354\260\275\354\236\221\354\235\204 \353\271\204\352\265\220\355\225\264 \353\263\264\354\204\270\354\232\224...\"\n          />\n          <button \n            disabled={isComparing || !prompt.trim()}\n            onClick={handleCompareGenerate}\n            className={`bg-secondary text-on-secondary hover:opacity-90 font-semibold text-xs px-5 py-2.5 rounded flex items-center gap-2 transition-all cursor-pointer ${\n              (isComparing || !prompt.trim()) ? \"opacity-50 cursor-not-allowed\" : \"\"\n            }`}\n          >\n            <ArrowLeftRight size={14} className={isComparing ? \"animate-spin\" : \"\"} />\n            <span>{isComparing ? \"\354\260\275\354\236\221 \353\271\204\352\265\220 \354\244\221...\" : \"\353\214\200\354\241\260 \354\260\275\354\236\221 \354\213\234\354\236\221\"}</span>\n          </button>\n        </div>\n\n        {/* 2-Columns grid representing model outputs */}\n        <div className=\"grid grid-cols-1 xl:grid-cols-2 gap-gutter h-full\">\n          \n          {/* Persona 1 Output (Movie) */}\n          <div className=\"bg-surface-dark rounded-lg border border-outline/30 flex flex-col overflow-hidden max-h-[500px]\">\n            <div className=\"p-4 border-b border-outline/30 bg-panel-dark flex justify-between items-center\">\n              <div className=\"flex items-center gap-3\">\n                <span className=\"text-secondary\">\360\237\216\254</span>\n                <h3 className=\"font-sans text-lg font-bold text-inverse-on-surface\">{modelA.name}</h3>\n              </div>\n              <span className=\"px-2 py-1 bg-surface-dark border border-secondary text-secondary font-mono text-[10px] rounded\">\n                LORA: {modelA.loraAdapter}\n              </span>\n            </div>\n            <div className=\"p-6 overflow-y-auto flex-1 font-serif text-base text-outline-variant leading-relaxed select-all whitespace-pre-wrap\">\n              {contentA}\n            </div>\n          </div>\n\n          {/* Persona 2 Output (Novel) */}\n          <div className=\"bg-surface-dark rounded-lg border border-outline/30 flex flex-col overflow-hidden max-h-[500px]\">\n            <div className=\"p-4 border-b border-outline/30 bg-panel-dark flex justify-between items-center\">\n              <div className=\"flex items-center gap-3\">\n                <span className=\"text-primary-fixed-dim\">\360\237\223\232</span>\n                <h3 className=\"font-sans text-lg font-bold text-inverse-on-surface\">{modelB.name}</h3>\n              </div>\n              <span className=\"px-2 py-1 bg-surface-dark border border-primary-fixed-dim text-primary-fixed-dim font-mono text-[10px] rounded\">\n                LORA: {modelB.loraAdapter}\n              </span>\n            </div>\n            <div className=\"p-6 overflow-y-auto flex-1 font-serif text-base text-outline-variant leading-relaxed select-all whitespace-pre-wrap\">\n              {contentB}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Right Column Evaluation Panel (Dark precise style) */}\n      <aside className=\"w-eval-panel-width bg-surface-dark border-l border-outline/20 p-6 flex flex-col gap-8 h-full overflow-y-auto text-outline-variant\">\n        \n        {/* Appraisal details */}\n        <div>\n          <h3 className=\"font-mono text-xs text-secondary mb-4 flex items-center gap-2\">\n            <Terminal size={14} className=\"text-secondary\" /> \n            \355\217\211\352\260\200 \354\247\200\355\221\234 (\354\242\205\355\225\251 \353\214\200\354\241\260)\n          </h3>\n          \n          <div className=\"space-y-6\">\n            <div>\n              <div className=\"flex justify-between mb-2 text-xs font-mono\">\n                <span>\354\212\244\355\203\200\354\235\274 \354\235\274\352\264\200\354\204\261</span>\n                <span className=\"text-secondary\">{metricStyle}%</span>\n              </div>\n              <div className=\"w-full bg-panel-dark h-1 rounded-full overflow-hidden\">\n                <div className=\"bg-secondary h-full transition-all duration-500\" style={{ width: `${metricStyle}%` }}></div>\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex justify-between mb-2 text-xs font-mono\">\n                <span>\354\236\245\353\245\264 \354\240\201\355\225\251\354\204\261</span>\n                <span className=\"text-secondary\">{metricGenre}%</span>\n              </div>\n              <div className=\"w-full bg-panel-dark h-1 rounded-full overflow-hidden\">\n                <div className=\"bg-secondary h-full transition-all duration-500\" style={{ width: `${metricGenre}%` }}></div>\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex justify-between mb-2 text-xs font-mono\">\n                <span>\355\230\270\355\235\241 \354\241\260\354\240\210</span>\n                <span className=\"text-outline\">{metricPacing}%</span>\n              </div>\n              <div className=\"w-full bg-panel-dark h-1 rounded-full overflow-hidden\">\n                <div className=\"bg-outline h-full transition-all duration-500\" style={{ width: `${metricPacing}%` }}></div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Risk Indicators */}\n        <div>\n          <h3 className=\"font-mono text-xs text-secondary mb-4 flex items-center gap-2\">\n            <AlertTriangle size={14} className=\"text-secondary\" />\n            \353\246\254\354\212\244\355\201\254 \354\247\200\355\221\234\n          </h3>\n\n          <div className=\"grid grid-cols-2 gap-3\">\n            <div className=\"bg-panel-dark p-3 rounded border border-outline/20 flex flex-col items-center justify-center text-center\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-success mb-2 shadow-[0_0_8px_rgba(47,166,106,0.5)]\"></span>\n              <span className=\"font-sans text-[10px] text-outline-variant\">\355\216\230\353\245\264\354\206\214\353\202\230 \354\230\244\354\227\274\353\217\204</span>\n              <span className=\"font-mono text-xs text-success mt-1 font-bold\">\353\202\256\354\235\214</span>\n            </div>\n\n            <div className=\"bg-panel-dark p-3 rounded border border-outline/20 flex flex-col items-center justify-center text-center\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-warning mb-2 shadow-[0_0_8px_rgba(217,154,53,0.5)]\"></span>\n              <span className=\"font-sans text-[10px] text-outline-variant\">\355\201\264\353\246\254\354\205\260 \353\260\200\353\217\204</span>\n              <span className=\"font-mono text-xs text-warning mt-1 font-bold\">\353\263\264\355\206\265</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Diagnostics Log Console Terminal */}\n        <div className=\"mt-auto\">\n          <h3 className=\"font-mono text-xs text-secondary mb-3\">\354\247\204\353\213\250 \353\241\234\352\267\270</h3>\n          <div className=\"bg-panel-dark rounded p-3 font-mono text-[10px] text-outline leading-loose border border-outline/20 h-40 overflow-y-auto whitespace-pre-wrap select-all\">\n            {logs.map((log, i) => (\n              <div key={i} className=\"mb-1 text-outline-variant\">\n                {log}\n              </div>\n            ))}\n          </div>\n        </div>\n      </aside>\n    </div>\n  );\n}\n"
    }
