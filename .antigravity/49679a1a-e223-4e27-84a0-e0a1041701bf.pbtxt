    instruction: "Restyle EditorView to align with Editorial Aesthetic, injecting serif typography, square corners, sharp border lines, uppercase letter spacing, and stark controls."
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"flex-1 ml-0 md:ml-sidebar-width flex overflow-hidden\">\n      \n      {/* Center Column: Manuscript Editor */}\n      <div className=\"flex-1 bg-surface-warm overflow-y-auto relative flex justify-center pb-24 h-[calc(100vh-64px)]\">\n        <div className=\"w-full max-w-[800px] px-8 py-12 flex flex-col gap-8\">\n          \n          {/* Chat/Prompt Bubble */}\n          <div className=\"bg-surface p-6 rounded-lg border border-border-warm shadow-sm self-start w-full relative\">\n            <p className=\"font-mono text-xs text-muted-text mb-2 flex items-center gap-2\">\n              <User size={14} />\n              \353\224\224\353\240\211\355\204\260 \355\224\204\353\241\254\355\224\204\355\212\270\n            </p>\n            <textarea\n              value={prompt}\n              onChange={(e) => setPrompt(e.target.value)}\n              className=\"w-full min-h-[80px] bg-transparent border-none focus:outline-none focus:ring-0 text-on-surface text-sm max-w-prose leading-relaxed resize-y focus:bg-surface-container-low transition-colors p-2 rounded\"\n              placeholder=\"\354\260\275\354\236\221 \354\247\200\354\213\234 \355\230\271\354\235\200 \353\254\270\353\247\245 \352\260\200\354\235\264\353\223\234 \355\224\204\353\241\254\355\224\204\355\212\270\353\245\274 \354\236\205\353\240\245\355\225\230\354\204\270\354\232\224...\"\n            />\n            <div className=\"flex justify-between items-center mt-2 pt-2 border-t border-border-warm/50 text-[11px] text-muted-text\">\n              <span>\355\216\230\353\245\264\354\206\214\353\202\230: {currentPersona.name}</span>\n              <span>\354\226\264\353\214\221\355\204\260: {currentPersona.loraAdapter}</span>\n            </div>\n          </div>\n\n          {/* Manuscript Output Card */}\n          <article className=\"flex-1 flex flex-col pt-4\">\n            <input \n              value={title}\n              onChange={(e) => setTitle(e.target.value)}\n              className=\"font-headline-lg text-headline-lg text-ink mb-6 bg-transparent border-none focus:outline-none focus:ring-0 w-full hover:bg-surface-container-low p-1 rounded font-bold\"\n              placeholder=\"\354\233\220\352\263\240 \354\240\234\353\252\251\354\235\204 \354\236\205\353\240\245\355\225\230\354\204\270\354\232\224\"\n            />\n            \n            <div className=\"flex-1 relative min-h-[300px]\">\n              {isGenerating ? (\n                <div className=\"absolute inset-0 bg-surface-warm bg-opacity-70 flex flex-col justify-center items-center gap-3 z-10\">\n                  <RefreshCw className=\"text-primary animate-spin\" size={32} />\n                  <p className=\"font-sans text-sm font-medium text-on-surface-variant\">\n                    {currentPersona.name} \352\260\200 \354\233\220\352\263\240\353\245\274 \354\203\235\354\204\261\355\225\230\352\263\240 \354\236\210\354\212\265\353\213\210\353\213\244...\n                  </p>\n                </div>\n              ) : null}\n\n              <textarea\n                value={content}\n                onChange={(e) => setContent(e.target.value)}\n                className=\"w-full h-full min-h-[350px] bg-transparent border-none focus:outline-none focus:ring-0 text-on-surface placeholder-outline-variant font-sans text-lg leading-relaxed resize-none\"\n                placeholder=\"\354\227\254\352\270\260\354\227\220 \354\236\220\354\234\240\353\241\255\352\262\214 \354\235\264\354\225\274\352\270\260\353\245\274 \354\240\201\354\226\264 \353\202\264\353\240\244\352\260\200\352\261\260\353\202\230, \353\224\224\353\240\211\355\204\260 \355\224\204\353\241\254\355\224\204\355\212\270\353\245\274 \354\210\230\354\240\225\355\225\234 \355\233\204 \354\225\204\353\236\230 \'\354\236\254\354\236\221\354\204\261\' \353\262\204\355\212\274\354\234\274\353\241\234 AI\354\235\230 \354\260\275\354\236\221\354\235\204 \354\213\234\354\236\221\355\225\264 \353\263\264\354\204\270\354\232\224.\"\n              />\n            </div>\n          </article>\n        </div>\n\n        {/* Floating Action Bar */}\n        <div className=\"fixed bottom-8 left-[calc(280px+(100vw-280px-320px)/2)] -translate-x-1/2 bg-surface border border-border-warm rounded-full shadow-[0_4px_20px_rgba(0,0,0,0.05)] px-4 py-2 flex items-center gap-3 z-10 transition-all duration-300\">\n          <button \n            disabled={isGenerating || !prompt.trim()}\n            onClick={handleGenerate}\n            className={`flex items-center gap-2 px-4 py-2 text-primary text-xs font-semibold hover:bg-surface-container-low rounded-full transition-all cursor-pointer ${\n              (!prompt.trim() || isGenerating) ? \'opacity-40 cursor-not-allowed\' : \'\'\n            }`}\n          >\n            <RefreshCw size={14} className={isGenerating ? \"animate-spin\" : \"\"} />\n            <span>\354\236\254\354\236\221\354\204\261 (AI \354\203\235\354\204\261)</span>\n          </button>\n          \n          <div className=\"w-px h-4 bg-border-warm\"></div>\n          \n          <button \n            disabled={isSaving || !content.trim()}\n            onClick={handleSave}\n            className={`flex items-center gap-2 px-6 py-2 bg-primary text-on-primary text-xs font-semibold rounded-full hover:bg-opacity-90 transition-all shadow-sm cursor-pointer ${\n              (!content.trim() || isSaving) ? \'opacity-50 cursor-not-allowed\' : \'\'\n            }`}\n          >\n            <Save size={14} />\n            <span>{isSaving ? \"\354\240\200\354\236\245 \354\244\221...\" : \"\354\264\210\354\225\210 \354\240\200\354\236\245\"}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Right Column: Style Guide & Parameter Panel */}\n      <aside className=\"w-eval-panel-width bg-panel-dark border-l border-surface-dark flex flex-col h-full overflow-y-auto z-10 text-outline-variant\">\n        {/* Adapter Status */}\n        <div className=\"p-6 border-b border-surface-dark/50\">\n          <h3 className=\"font-mono text-xs text-tertiary-fixed tracking-widest mb-1.5 uppercase\">\n            \354\212\244\355\203\200\354\235\274 \352\260\200\354\235\264\353\223\234 \355\231\234\354\204\261\n          </h3>\n          <p className=\"font-headline-md text-xl text-surface-warm font-bold tracking-tight\">\n            {currentPersona.loraAdapter}\n          </p>\n          <p className=\"text-[11px] text-muted-text mt-1\">\n            \355\216\230\353\245\264\354\206\214\353\202\230: {currentPersona.name}\n          </p>\n        </div>\n\n        {/* LoRA Parameters Controller */}\n        <div className=\"p-6 border-b border-surface-dark/50\">\n          <h4 className=\"font-mono text-xs text-outline-variant mb-4 flex items-center gap-2\">\n            <Sliders size={14} />\n            LoRA \354\240\234\354\226\264 \355\214\214\353\235\274\353\257\270\355\204\260\n          </h4>\n          \n          <div className=\"space-y-4\">\n            <div>\n              <div className=\"flex justify-between text-[11px] mb-1 font-mono\">\n                <span>Temperature</span>\n                <span>{temperature.toFixed(2)}</span>\n              </div>\n              <input \n                type=\"range\" min=\"0.1\" max=\"1.0\" step=\"0.05\"\n                value={temperature}\n                onChange={(e) => setTemperature(parseFloat(e.target.value))}\n                className=\"w-full accent-primary bg-surface-dark h-1 rounded-lg appearance-none cursor-pointer\"\n              />\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-[11px] mb-1 font-mono\">\n                <span>Top P</span>\n                <span>{topP.toFixed(2)}</span>\n              </div>\n              <input \n                type=\"range\" min=\"0.1\" max=\"1.0\" step=\"0.05\"\n                value={topP}\n                onChange={(e) => setTopP(parseFloat(e.target.value))}\n                className=\"w-full accent-primary bg-surface-dark h-1 rounded-lg appearance-none cursor-pointer\"\n              />\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-[11px] mb-1 font-mono\">\n                <span>Presence Penalty</span>\n                <span>{presencePenalty.toFixed(2)}</span>\n              </div>\n              <input \n                type=\"range\" min=\"-2.0\" max=\"2.0\" step=\"0.1\"\n                value={presencePenalty}\n                onChange={(e) => setPresencePenalty(parseFloat(e.target.value))}\n                className=\"w-full accent-primary bg-surface-dark h-1 rounded-lg appearance-none cursor-pointer\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Evaluation Metrics */}\n        <div className=\"p-6 border-b border-surface-dark/50\" id=\"evaluation-details\">\n          <div className=\"flex justify-between items-center mb-4\">\n            <h4 className=\"font-mono text-xs text-outline-variant flex items-center gap-2\">\n              <FileText size={14} />\n              AI \354\213\244\354\213\234\352\260\204 \355\206\244 \353\266\204\354\204\235\n            </h4>\n            <button \n              onClick={() => handleEvaluate()}\n              disabled={isEvaluating || !content.trim()}\n              className={`text-[10px] bg-secondary text-on-secondary px-2 py-1 rounded hover:bg-opacity-90 flex items-center gap-1 cursor-pointer ${\n                (!content.trim() || isEvaluating) ? \'opacity-40 cursor-not-allowed\' : \'\'\n              }`}\n            >\n              <Play size={8} />\n              <span>{isEvaluating ? \"\353\266\204\354\204\235 \354\244\221\" : \"\353\266\204\354\204\235 \354\213\234\354\236\221\"}</span>\n            </button>\n          </div>\n          \n          <div className=\"space-y-4\">\n            <div>\n              <div className=\"flex justify-between text-[11px] mb-1\">\n                <span>\354\212\244\355\203\200\354\235\274 \354\235\274\352\264\200\354\204\261</span>\n                <span className=\"text-secondary font-mono\">{evalResult ? evalResult.metricStyleConsistency : 0}%</span>\n              </div>\n              <div className=\"h-1 bg-surface-dark rounded-full overflow-hidden\">\n                <div \n                  className=\"h-full bg-secondary-container rounded-full transition-all duration-500\"\n                  style={{ width: `${evalResult ? evalResult.metricStyleConsistency : 0}%` }}\n                ></div>\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-[11px] mb-1\">\n                <span>\354\236\245\353\245\264 \354\240\201\355\225\251\354\204\261</span>\n                <span className=\"text-secondary font-mono\">{evalResult ? evalResult.metricGenreFit : 0}%</span>\n              </div>\n              <div className=\"h-1 bg-surface-dark rounded-full overflow-hidden\">\n                <div \n                  className=\"h-full bg-secondary-container rounded-full transition-all duration-500\"\n                  style={{ width: `${evalResult ? evalResult.metricGenreFit : 0}%` }}\n                ></div>\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-[11px] mb-1\">\n                <span>\355\230\270\355\235\241 \354\241\260\354\240\210 / \352\260\220\352\260\201 \353\254\230\354\202\254</span>\n                <span className=\"text-outline font-mono\">{evalResult ? evalResult.metricPacing : 0}%</span>\n              </div>\n              <div className=\"h-1 bg-surface-dark rounded-full overflow-hidden\">\n                <div \n                  className=\"h-full bg-outline rounded-full transition-all duration-500\"\n                  style={{ width: `${evalResult ? evalResult.metricPacing : 0}%` }}\n                ></div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Risk Indicators & Compliance */}\n        <div className=\"p-6 border-b border-surface-dark/50\">\n          <h4 className=\"font-mono text-xs text-outline-variant mb-3 flex items-center gap-1.5\">\n            <AlertCircle size={14} />\n            \354\212\244\355\203\200\354\235\274 \354\244\200\354\210\230 \353\246\254\354\212\244\355\201\254\n          </h4>\n          <div className=\"space-y-2 text-xs\">\n            <div className=\"flex items-center justify-between p-2 rounded bg-surface-dark/40 border border-surface-dark/30\">\n              <span className=\"flex items-center gap-2\">\n                <span className={`w-2 h-2 rounded-full ${evalResult && evalResult.riskPersonaContamination === \'\353\202\256\354\235\214\' ? \'bg-success\' : \'bg-warning\'}`}></span>\n                \355\216\230\353\245\264\354\206\214\353\202\230 \354\230\244\354\227\274\353\217\204\n              </span>\n              <span className=\"font-mono text-on-primary-container text-[10px] bg-border-warm bg-opacity-20 px-1.5 py-0.5 rounded\">\n                {evalResult ? evalResult.riskPersonaContamination : \"\353\252\250\353\246\204\"}\n              </span>\n            </div>\n\n            <div className=\"flex items-center justify-between p-2 rounded bg-surface-dark/40 border border-surface-dark/30\">\n              <span className=\"flex items-center gap-2\">\n                <span className={`w-2 h-2 rounded-full ${evalResult && evalResult.riskClicheDensity === \'\353\202\256\354\235\214\' ? \'bg-success\' : \'bg-warning\'}`}></span>\n                \355\201\264\353\246\254\354\205\260 \353\260\200\353\217\204\n              </span>\n              <span className=\"font-mono text-on-primary-container text-[10px] bg-border-warm bg-opacity-20 px-1.5 py-0.5 rounded\">\n                {evalResult ? evalResult.riskClicheDensity : \"\353\252\250\353\246\204\"}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Word Counts */}\n        <div className=\"p-6 mt-auto border-t border-surface-dark/50\">\n          <div className=\"flex justify-between text-xs text-muted-text\">\n            <span>\354\264\235 \353\213\250\354\226\264 \354\210\230</span>\n            <span className=\"font-mono font-medium text-surface-warm\">{wordCount.toLocaleString()} words</span>\n          </div>\n          <div className=\"flex justify-between text-[11px] text-muted-text mt-1\">\n            <span>\354\233\220\352\263\240 \352\264\200\353\246\254 \354\203\201\355\203\234</span>\n            <span className=\"capitalize font-mono text-success flex items-center gap-1\">\n              <CheckCircle2 size={10} /> {status}\n            </span>\n          </div>\n        </div>\n      </aside>\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"flex-1 ml-0 md:ml-sidebar-width flex overflow-hidden\">\n      \n      {/* Center Column: Manuscript Editor */}\n      <div className=\"flex-1 bg-bg-warm overflow-y-auto relative flex justify-center pb-24 h-[calc(100vh-64px)]\">\n        <div className=\"w-full max-w-[800px] px-8 py-12 flex flex-col gap-8\">\n          \n          {/* Chat/Prompt Bubble */}\n          <div className=\"bg-surface-warm p-6 rounded-none border border-border-warm self-start w-full relative\">\n            <p className=\"font-mono text-[9px] tracking-[0.3em] uppercase text-secondary mb-3 flex items-center gap-2 font-bold\">\n              <User size={12} />\n              \353\224\224\353\240\211\355\204\260 \352\270\260\355\232\215 \352\260\200\354\235\264\353\223\234 (\355\224\204\353\241\254\355\224\204\355\212\270)\n            </p>\n            <textarea\n              value={prompt}\n              onChange={(e) => setPrompt(e.target.value)}\n              className=\"w-full min-h-[80px] bg-[#141414] border border-border-warm focus:border-secondary focus:outline-none text-on-surface text-xs leading-relaxed resize-y p-3 transition-colors rounded-none font-sans\"\n              placeholder=\"\354\260\275\354\236\221 \354\247\200\354\213\234 \355\230\271\354\235\200 \353\254\270\353\247\245 \352\260\200\354\235\264\353\223\234 \355\224\204\353\241\254\355\224\204\355\212\270\353\245\274 \354\236\205\353\240\245\355\225\230\354\204\270\354\232\224...\"\n            />\n            <div className=\"flex justify-between items-center mt-3 pt-3 border-t border-border-warm/50 text-[10px] font-mono tracking-wider text-muted-text uppercase\">\n              <span>\355\216\230\353\245\264\354\206\214\353\202\230: {currentPersona.name}</span>\n              <span>LORA: {currentPersona.loraAdapter}</span>\n            </div>\n          </div>\n\n          {/* Manuscript Output Card */}\n          <article className=\"flex-1 flex flex-col pt-4\">\n            <input \n              value={title}\n              onChange={(e) => setTitle(e.target.value)}\n              className=\"font-serif italic text-3xl text-ink mb-6 bg-transparent border-b border-border-warm/30 focus:border-border-warm focus:outline-none w-full p-2 rounded-none font-semibold\"\n              placeholder=\"\354\233\220\352\263\240 \354\240\234\353\252\251\354\235\204 \354\236\205\353\240\245\355\225\230\354\204\270\354\232\224\"\n            />\n            \n            <div className=\"flex-1 relative min-h-[300px]\">\n              {isGenerating ? (\n                <div className=\"absolute inset-0 bg-bg-warm bg-opacity-80 flex flex-col justify-center items-center gap-3 z-10\">\n                  <RefreshCw className=\"text-secondary animate-spin\" size={24} />\n                  <p className=\"font-mono text-[10px] tracking-[0.2em] uppercase text-on-surface-variant font-bold\">\n                    {currentPersona.name} \352\260\200 \354\233\220\352\263\240\353\245\274 \354\247\221\355\225\204 \354\244\221\354\236\205\353\213\210\353\213\244...\n                  </p>\n                </div>\n              ) : null}\n\n              <textarea\n                value={content}\n                onChange={(e) => setContent(e.target.value)}\n                className=\"w-full h-full min-h-[350px] bg-transparent border-none focus:outline-none focus:ring-0 text-on-surface placeholder-outline-variant font-serif text-base leading-loose tracking-wide resize-none\"\n                placeholder=\"\354\227\254\352\270\260\354\227\220 \354\236\220\354\234\240\353\241\255\352\262\214 \354\235\264\354\225\274\352\270\260\353\245\274 \354\240\201\354\226\264 \353\202\264\353\240\244\352\260\200\352\261\260\353\202\230, \353\224\224\353\240\211\355\204\260 \355\224\204\353\241\254\355\224\204\355\212\270\353\245\274 \354\210\230\354\240\225\355\225\234 \355\233\204 \354\225\204\353\236\230 \'\354\236\254\354\236\221\354\204\261\' \353\262\204\355\212\274\354\234\274\353\241\234 AI\354\235\230 \354\260\275\354\236\221\354\235\204 \354\213\234\354\236\221\355\225\264 \353\263\264\354\204\270\354\232\224.\"\n              />\n            </div>\n          </article>\n        </div>\n\n        {/* Floating Action Bar */}\n        <div className=\"fixed bottom-8 left-[calc(280px+(100vw-280px-320px)/2)] -translate-x-1/2 bg-surface-dark border border-border-warm px-6 py-3 flex items-center gap-4 z-10 transition-all shadow-2xl rounded-none\">\n          <button \n            disabled={isGenerating || !prompt.trim()}\n            onClick={handleGenerate}\n            className={`flex items-center gap-2 border border-primary text-primary hover:bg-primary hover:text-on-primary bg-transparent text-[10px] font-bold tracking-[0.2em] px-5 py-2.5 uppercase transition-all cursor-pointer ${\n              (!prompt.trim() || isGenerating) ? \'opacity-40 cursor-not-allowed\' : \'\'\n            }`}\n          >\n            <RefreshCw size={12} className={isGenerating ? \"animate-spin\" : \"\"} />\n            <span>AI \354\236\254\354\247\221\355\225\204</span>\n          </button>\n          \n          <div className=\"w-px h-6 bg-border-warm\"></div>\n          \n          <button \n            disabled={isSaving || !content.trim()}\n            onClick={handleSave}\n            className={`flex items-center gap-2 bg-primary text-on-primary hover:bg-opacity-95 text-[10px] font-bold tracking-[0.2em] px-6 py-2.5 uppercase transition-all cursor-pointer ${\n              (!content.trim() || isSaving) ? \'opacity-50 cursor-not-allowed\' : \'\'\n            }`}\n          >\n            <Save size={12} />\n            <span>{isSaving ? \"\354\240\200\354\236\245 \354\244\221...\" : \"\354\233\220\352\263\240 \353\263\264\354\241\264 (\354\240\200\354\236\245)\"}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Right Column: Style Guide & Parameter Panel */}\n      <aside className=\"w-eval-panel-width bg-panel-dark border-l border-[#202020] flex flex-col h-full overflow-y-auto z-10 text-on-surface\">\n        {/* Adapter Status */}\n        <div className=\"p-6 border-b border-border-warm/40 bg-[#0A0A0A]\">\n          <h3 className=\"font-mono text-[9px] tracking-[0.3em] text-secondary uppercase mb-2 font-bold\">\n            STYLE CONFIG : ACTIVE\n          </h3>\n          <p className=\"font-serif text-lg text-ink font-normal italic tracking-tight\">\n            {currentPersona.loraAdapter}\n          </p>\n          <p className=\"font-sans text-[10px] tracking-wide text-on-surface-variant mt-1.5 opacity-80\">\n            \355\216\230\353\245\264\354\206\214\353\202\230: {currentPersona.name}\n          </p>\n        </div>\n\n        {/* LoRA Parameters Controller */}\n        <div className=\"p-6 border-b border-border-warm/40\">\n          <h4 className=\"font-mono text-[9px] tracking-[0.3em] text-on-surface-variant mb-5 uppercase flex items-center gap-2 font-bold\">\n            <Sliders size={12} />\n            LORA WEIGHTS CONTROLS\n          </h4>\n          \n          <div className=\"space-y-5\">\n            <div>\n              <div className=\"flex justify-between text-[10px] font-mono mb-2\">\n                <span className=\"opacity-70\">Temperature</span>\n                <span className=\"text-secondary font-bold\">{temperature.toFixed(2)}</span>\n              </div>\n              <input \n                type=\"range\" min=\"0.1\" max=\"1.0\" step=\"0.05\"\n                value={temperature}\n                onChange={(e) => setTemperature(parseFloat(e.target.value))}\n                className=\"w-full h-[2px] bg-border-warm appearance-none cursor-pointer accent-white\"\n              />\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-[10px] font-mono mb-2\">\n                <span className=\"opacity-70\">Top P</span>\n                <span className=\"text-secondary font-bold\">{topP.toFixed(2)}</span>\n              </div>\n              <input \n                type=\"range\" min=\"0.1\" max=\"1.0\" step=\"0.05\"\n                value={topP}\n                onChange={(e) => setTopP(parseFloat(e.target.value))}\n                className=\"w-full h-[2px] bg-border-warm appearance-none cursor-pointer accent-white\"\n              />\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-[10px] font-mono mb-2\">\n                <span className=\"opacity-70\">Presence Penalty</span>\n                <span className=\"text-secondary font-bold\">{presencePenalty.toFixed(2)}</span>\n              </div>\n              <input \n                type=\"range\" min=\"-2.0\" max=\"2.0\" step=\"0.1\"\n                value={presencePenalty}\n                onChange={(e) => setPresencePenalty(parseFloat(e.target.value))}\n                className=\"w-full h-[2px] bg-border-warm appearance-none cursor-pointer accent-white\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Evaluation Metrics */}\n        <div className=\"p-6 border-b border-border-warm/40\" id=\"evaluation-details\">\n          <div className=\"flex justify-between items-center mb-5\">\n            <h4 className=\"font-mono text-[9px] tracking-[0.3em] text-on-surface-variant uppercase flex items-center gap-2 font-bold\">\n              <FileText size={12} />\n              AI REAL-TIME METRICS\n            </h4>\n            <button \n              onClick={() => handleEvaluate()}\n              disabled={isEvaluating || !content.trim()}\n              className={`text-[9px] border border-[#3A3A3A] hover:border-primary text-on-surface px-2.5 py-1 tracking-wider uppercase bg-transparent transition-all cursor-pointer font-mono ${\n                (!content.trim() || isEvaluating) ? \'opacity-40 cursor-not-allowed\' : \'\'\n              }`}\n            >\n              <span>{isEvaluating ? \"ANALYZING\" : \"RUN EVAL\"}</span>\n            </button>\n          </div>\n          \n          <div className=\"space-y-4\">\n            <div>\n              <div className=\"flex justify-between text-[10px] font-mono mb-1.5 grayscale opacity-90\">\n                <span>STYLE CONSISTENCY</span>\n                <span className=\"text-secondary font-bold\">{evalResult ? evalResult.metricStyleConsistency : 0}%</span>\n              </div>\n              <div className=\"h-[2px] bg-border-warm overflow-hidden\">\n                <div \n                  className=\"h-full bg-white transition-all duration-500\"\n                  style={{ width: `${evalResult ? evalResult.metricStyleConsistency : 0}%` }}\n                ></div>\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-[10px] font-mono mb-1.5 grayscale opacity-90\">\n                <span>GENRE COMPLIANCE</span>\n                <span className=\"text-secondary font-bold\">{evalResult ? evalResult.metricGenreFit : 0}%</span>\n              </div>\n              <div className=\"h-[2px] bg-border-warm overflow-hidden\">\n                <div \n                  className=\"h-full bg-white transition-all duration-500\"\n                  style={{ width: `${evalResult ? evalResult.metricGenreFit : 0}%` }}\n                ></div>\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-[10px] font-mono mb-1.5 grayscale opacity-90\">\n                <span>PACING & DESCRIPTIVE PROSE</span>\n                <span className=\"text-on-surface font-bold\">{evalResult ? evalResult.metricPacing : 0}%</span>\n              </div>\n              <div className=\"h-[2px] bg-border-warm overflow-hidden\">\n                <div \n                  className=\"h-full bg-white transition-all duration-500\"\n                  style={{ width: `${evalResult ? evalResult.metricPacing : 0}%` }}\n                ></div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Risk Indicators & Compliance */}\n        <div className=\"p-6 border-b border-border-warm/40\">\n          <h4 className=\"font-mono text-[9px] tracking-[0.3em] text-on-surface-variant mb-4 uppercase flex items-center gap-1.5 font-bold\">\n            <AlertCircle size={12} />\n            LORA COMPLIANCE RISKS\n          </h4>\n          <div className=\"space-y-2 text-[10px] font-mono\">\n            <div className=\"flex items-center justify-between p-2.5 bg-[#0A0A0A] border border-border-warm\">\n              <span className=\"flex items-center gap-2\">\n                <span className={`w-1.5 h-1.5 ${evalResult && evalResult.riskPersonaContamination === \'\353\202\256\354\235\214\' ? \'bg-success\' : \'bg-warning\'}`}></span>\n                CONTAMINATION RISK\n              </span>\n              <span className=\"text-white uppercase font-bold text-[9px] tracking-widest pl-1.5\">\n                {evalResult ? evalResult.riskPersonaContamination : \"N/A\"}\n              </span>\n            </div>\n\n            <div className=\"flex items-center justify-between p-2.5 bg-[#0A0A0A] border border-border-warm\">\n              <span className=\"flex items-center gap-2\">\n                <span className={`w-1.5 h-1.5 ${evalResult && evalResult.riskClicheDensity === \'\353\202\256\354\235\214\' ? \'bg-success\' : \'bg-warning\'}`}></span>\n                CLICH\303\211 DENSITY\n              </span>\n              <span className=\"text-white uppercase font-bold text-[9px] tracking-widest pl-1.5\">\n                {evalResult ? evalResult.riskClicheDensity : \"N/A\"}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Word Counts */}\n        <div className=\"p-6 mt-auto border-t border-border-warm/40 bg-[#0A0A0A]\">\n          <div className=\"flex justify-between text-[10px] font-mono text-on-surface-variant uppercase tracking-wider\">\n            <span>VOLUME</span>\n            <span className=\"font-bold text-white\">{wordCount.toLocaleString()} WORDS</span>\n          </div>\n          <div className=\"flex justify-between text-[10px] font-mono text-on-surface-variant uppercase tracking-wider mt-2.5\">\n            <span>STATUS</span>\n            <span className=\"text-success flex items-center gap-1 font-bold\">\n              <CheckCircle2 size={10} /> {status}\n            </span>\n          </div>\n        </div>\n      </aside>\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
}
