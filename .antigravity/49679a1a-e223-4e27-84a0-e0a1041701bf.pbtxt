xt-secondary\">\355\231\234\354\204\261\355\231\224\353\220\234 \355\216\230\353\245\264\354\206\214\353\202\230: Noir Detective V4</span>\n            <span className=\"text-muted-text\">352 words</span>\n          </div>\n        </div>\n\n        {/* Floating Persona Cards */}\n        <motion.div \n          animate={{ y: [0, -6, 0] }}\n          transition={{ duration: 4, repeat: Infinity, ease: \"easeInOut\" }}\n          className=\"absolute z-30 top-10 -left-10 bg-surface-warm border border-primary rounded p-3 shadow-md transform -rotate-3 w-48\"\n        >\n          <div className=\"flex items-center gap-2 mb-2\">\n            <Gamepad2 className=\"text-primary\" size={16} />\n            <span className=\"font-sans text-xs font-bold text-on-surface\">\352\262\214\354\236\204 \353\235\274\354\235\264\355\204\260</span>\n          </div>\n          <div className=\"font-mono text-[10px] text-secondary bg-secondary bg-opacity-10 px-2 py-0.5 rounded inline-block\">\n            LoRA: RPG_Quest_Gen\n          </div>\n        </motion.div>\n\n        <motion.div \n          animate={{ y: [0, 8, 0] }}\n          transition={{ duration: 5, repeat: Infinity, ease: \"easeInOut\", delay: 0.5 }}\n          className=\"absolute z-10 bottom-20 -right-4 bg-surface-warm border border-border-warm rounded p-3 shadow-sm transform rotate-6 w-48 opacity-80 hover:opacity-100 transition-opacity\"\n        >\n          <div className=\"flex items-center gap-2 mb-2\">\n            <Film className=\"text-tertiary\" size={16} />\n            <span className=\"font-sans text-xs font-bold text-on-surface\">\354\230\201\355\231\224 \353\214\200\353\263\270</span>\n          </div>\n          <div className=\"font-mono text-[10px] text-tertiary bg-tertiary bg-opacity-10 px-2 py-0.5 rounded inline-block\">\n            LoRA: Screenplay_Format\n          </div>\n        </motion.div>\n\n        {/* Evaluation Match Meter Float */}\n        <motion.div \n          initial={{ scale: 0.9, opacity: 0 }}\n          animate={{ scale: 1, opacity: 1 }}\n          transition={{ duration: 0.5, delay: 0.4 }}\n          className=\"absolute z-10 top-32 -right-8 bg-surface-dark text-on-primary border border-surface-variant rounded p-3 shadow-lg transform rotate-2 w-56 hidden md:block text-xs\"\n        >\n          <div className=\"font-mono text-[10px] text-tertiary-fixed mb-2 flex justify-between\">\n            <span>\354\212\244\355\203\200\354\235\274 \355\217\211\352\260\200</span><span>94% \354\235\274\354\271\230</span>\n          </div>\n          <div className=\"w-full bg-surface-variant h-1 rounded-full mb-3 overflow-hidden\">\n            <div className=\"bg-tertiary-fixed h-full rounded-full w-[94%]\"></div>\n          </div>\n          <div className=\"flex items-center gap-1.5 text-[10px] text-outline-variant\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-success inline-block\"></span> \355\206\244 \354\235\274\352\264\200\354\204\261 \354\232\260\354\210\230\n          </div>\n        </motion.div>\n      </motion.div>\n    </div>\n  );\n}"
      replacement_content: "export default function LandingView({ onStartWriting, onExplorePersonas }: LandingViewProps) {\n  return (\n    <div className=\"flex-grow pt-24 px-margin-page w-full max-w-[1400px] mx-auto flex flex-col lg:flex-row gap-12 items-center justify-center min-h-[calc(100vh-80px)]\">\n      {/* Hero Text */}\n      <motion.div \n        initial={{ opacity: 0, x: -30 }}\n        animate={{ opacity: 1, x: 0 }}\n        transition={{ duration: 0.6 }}\n        className=\"lg:w-1/2 flex flex-col gap-8 pr-4 z-10\"\n      >\n        <span className=\"text-[10px] font-mono tracking-[0.4em] text-secondary uppercase font-semibold\">\n          AI-Powered Persona Studio\n        </span>\n        <h1 className=\"font-serif text-5xl md:text-6xl text-ink max-w-[650px] leading-[1.15] font-normal italic break-keep\">\n          \353\213\271\354\213\240\354\235\230 \354\260\275\354\236\221\354\235\204 \354\231\204\354\204\261\355\225\240<br />\354\231\204\353\262\275\355\225\234 <span className=\"font-serif italic font-semibold border-b border-secondary pb-1\">AI \355\216\230\353\245\264\354\206\214\353\202\230</span>\n        </h1>\n        <p className=\"font-sans text-body-md text-on-surface-variant max-w-[500px] font-light break-keep leading-relaxed tracking-wide opacity-90\">\n          \354\240\204\353\254\270\354\240\201\354\235\270 \354\213\234\353\202\230\353\246\254\354\230\244 \354\236\221\352\260\200 \355\216\230\353\245\264\354\206\214\353\202\230\354\231\200 \354\240\225\352\265\220\355\225\234 LoRA \354\226\264\353\214\221\355\204\260 \352\270\260\354\210\240\354\235\264 \353\247\214\353\202\234 \354\240\204\354\232\251 \354\227\220\353\224\224\355\206\240\353\246\254\354\226\274 \354\212\244\355\212\234\353\224\224\354\230\244 \355\231\230\352\262\275\354\236\205\353\213\210\353\213\244. \354\260\275\354\236\221\354\235\230 \353\247\245\353\235\275\354\235\204 \354\231\204\353\262\275\355\236\210 \353\263\264\354\241\264\355\225\230\353\251\264\354\204\234 \353\213\244\354\226\221\355\225\234 \354\236\221\352\260\200 \355\216\230\353\245\264\354\206\214\353\202\230\353\245\274 \354\236\220\354\234\240\353\241\255\352\262\214 \354\230\244\352\260\200\353\251\260 \354\230\201\352\260\220\354\235\204 \354\261\204\354\232\260\354\204\270\354\232\224.\n        </p>\n        <div className=\"flex flex-col sm:flex-row gap-4 mt-4\">\n          <button \n            onClick={onStartWriting}\n            className=\"border border-primary text-primary hover:bg-primary hover:text-on-primary text-xs font-bold tracking-[0.2em] uppercase px-8 py-4 transition-all cursor-pointer bg-transparent\"\n          >\n            \354\247\221\355\225\204 \354\213\234\354\236\221\355\225\230\352\270\260\n          </button>\n          <button \n            onClick={onExplorePersonas}\n            className=\"border border-outline text-on-surface-variant hover:border-primary hover:text-primary text-xs font-bold tracking-[0.2em] uppercase px-8 py-4 transition-all cursor-pointer bg-transparent\"\n          >\n            \355\216\230\353\245\264\354\206\214\353\202\230 \353\246\254\354\212\244\355\212\270\n          </button>\n        </div>\n      </motion.div>\n\n      {/* Visual Composition */}\n      <motion.div \n        initial={{ opacity: 0, x: 30 }}\n        animate={{ opacity: 1, x: 0 }}\n        transition={{ duration: 0.8, delay: 0.1 }}\n        className=\"lg:w-1/2 relative w-full h-[600px] flex items-center justify-center p-4\"\n      >\n        {/* Abstract background graphic indicating studio space */}\n        <div className=\"absolute inset-x-4 inset-y-12 bg-surface-warm border border-border-warm transform rotate-1 z-0 hidden lg:block overflow-hidden\">\n          <div className=\"w-full h-8 border-b border-border-warm flex items-center px-4 gap-2 opacity-50\">\n            <div className=\"w-1.5 h-1.5 bg-border-warm rounded-full\"></div>\n            <div className=\"w-1.5 h-1.5 bg-border-warm rounded-full\"></div>\n            <div className=\"w-1.5 h-1.5 bg-border-warm rounded-full\"></div>\n          </div>\n        </div>\n\n        {/* Central Editor Window Mock */}\n        <div className=\"relative z-20 w-full max-w-[420px] bg-surface-warm border border-border-warm shadow-2xl p-7\">\n          <div className=\"font-mono text-[10px] text-muted-text mb-4 border-b border-border-warm pb-3 flex justify-between tracking-wider uppercase\">\n            <span>DRAFT: UNTITLED_v2</span>\n            <span>01/08</span>\n          </div>\n          <div className=\"space-y-4 font-sans text-xs text-on-surface leading-loose tracking-wide\">\n            <p className=\"opacity-80\">\353\204\244\354\230\250 \353\266\210\353\271\233\354\235\264 \353\217\204\354\213\234 \355\225\230\354\270\265 \352\265\254\354\227\255\354\235\230 \354\233\205\353\215\251\354\235\264\353\241\234 \354\212\244\353\251\260\353\223\244\352\263\240 \354\236\210\354\227\210\353\213\244. \355\203\234\354\226\221\354\235\230 \354\230\250\352\270\260\353\245\274 \354\236\212\354\235\200 \354\247\200 \354\230\244\353\236\230\353\220\234 \355\231\251\353\237\211\355\225\234 \353\263\265\355\225\251 \354\262\264\352\263\204\354\235\230 \353\217\204\354\213\234.</p>\n            <div className=\"flex items-start gap-3 bg-[#1A1A1A] p-4 border-l border-secondary\">\n              <span className=\"text-secondary text-base mt-px select-none\">\342\234\246</span>\n              <p className=\"text-[11px] leading-relaxed text-on-surface\">\n                \"\352\267\270\353\205\200\353\212\224 \355\212\270\353\240\214\354\271\230 \354\275\224\355\212\270\354\235\230 \354\271\274\353\235\274\353\245\274 \353\260\224\354\247\235 \354\204\270\354\233\240\354\247\200\353\247\214, \354\202\260\354\204\261 \353\271\204\352\260\200 \354\204\236\354\235\270 \354\212\244\353\252\250\352\267\270\353\241\234\353\266\200\355\204\260 \353\252\270\354\235\204 \354\247\200\355\202\254 \354\210\230\353\212\224 \354\227\206\354\227\210\353\213\244...\" <span className=\"animate-pulse font-bold text-secondary\">|</span>\n              </p>\n            </div>\n          </div>\n          <div className=\"mt-6 flex justify-between items-center pt-4 border-t border-border-warm text-[10px] font-mono\">\n            <span className=\"text-secondary uppercase tracking-widest\">LORA: SCREENPLAY_V4</span>\n            <span className=\"text-muted-text\">352 words</span>\n          </div>\n        </div>\n\n        {/* Floating Persona Cards */}\n        <motion.div \n          animate={{ y: [0, -4, 0] }}\n          transition={{ duration: 4, repeat: Infinity, ease: \"easeInOut\" }}\n          className=\"absolute z-30 top-12 left-2 bg-surface-warm border border-primary p-3.5 shadow-xl transform -rotate-2 w-48\"\n        >\n          <div className=\"flex items-center gap-2 mb-2\">\n            <Gamepad2 className=\"text-primary animate-pulse\" size={12} />\n            <span className=\"text-[10px] font-bold uppercase tracking-widest text-on-surface\">\352\262\214\354\236\204 \354\236\221\352\260\200</span>\n          </div>\n          <div className=\"font-mono text-[8px] text-secondary tracking-widest uppercase\">\n            LORA: RPG_QUEST_GEN\n          </div>\n        </motion.div>\n\n        <motion.div \n          animate={{ y: [0, 4, 0] }}\n          transition={{ duration: 5, repeat: Infinity, ease: \"easeInOut\", delay: 0.5 }}\n          className=\"absolute z-10 bottom-16 right-4 bg-surface-warm border border-border-warm p-3.5 shadow-lg transform rotate-3 w-48 opacity-80 hover:opacity-100 transition-opacity\"\n        >\n          <div className=\"flex items-center gap-2 mb-2\">\n            <Film className=\"text-tertiary\" size={12} />\n            <span className=\"text-[10px] font-bold uppercase tracking-widest text-on-surface font-sans\">\354\230\201\355\231\224 \352\260\201\353\263\270</span>\n          </div>\n          <div className=\"font-mono text-[8px] text-tertiary tracking-widest uppercase\">\n            LORA: SCREENPLAY_V1\n          </div>\n        </motion.div>\n\n        {/* Evaluation Match Meter Float */}\n        <motion.div \n          initial={{ scale: 0.9, opacity: 0 }}\n          animate={{ scale: 1, opacity: 1 }}\n          transition={{ duration: 0.5, delay: 0.4 }}\n          className=\"absolute z-10 top-32 -right-4 bg-surface-dark text-on-primary border border-border-warm p-4 shadow-2xl transform rotate-1 w-56 hidden md:block text-xs\"\n        >\n          <div className=\"font-mono text-[9px] text-on-surface-variant mb-2.5 flex justify-between uppercase tracking-wider\">\n            <span>\354\212\244\355\203\200\354\235\274 \354\235\274\354\271\230\354\234\250</span><span className=\"text-secondary font-bold\">94%</span>\n          </div>\n          <div className=\"w-full bg-[#202020] h-[3px] mb-3.5 overflow-hidden\">\n            <div className=\"bg-secondary h-full w-[94%]\"></div>\n          </div>\n          <div className=\"flex items-center gap-2 text-[9px] font-mono tracking-widest text-on-surface-variant uppercase\">\n            <span className=\"w-1.5 h-1.5 bg-success inline-block\"></span> \355\206\244 \354\235\274\352\264\200\354\204\261 \354\232\260\354\210\230\n          </div>\n        </motion.div>\n      </motion.div>\n    </div>\n  );\n}"
    }
