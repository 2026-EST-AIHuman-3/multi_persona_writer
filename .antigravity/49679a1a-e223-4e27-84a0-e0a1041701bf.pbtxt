    replacement_chunks {
      target_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { BookOpen, HelpCircle, Settings, User } from \"lucide-react\";\n\ninterface HeaderProps {\n  currentTab: \'landing\' | \'editor\' | \'archive\' | \'comparison\';\n  onChangeTab: (tab: \'landing\' | \'editor\' | \'archive\' | \'comparison\') => void;\n  onNewDraft: () => void;\n}\n\nexport default function Header({ currentTab, onChangeTab, onNewDraft }: HeaderProps) {\n  return (\n    <header className=\"bg-background border-b border-border-warm flex justify-between items-center px-margin-page h-16 w-full fixed top-0 z-50\">\n      <div className=\"flex items-center gap-8\">\n        <div \n          onClick={() => onChangeTab(\'landing\')}\n          className=\"font-headline-md text-headline-md font-bold text-primary cursor-pointer tracking-tight hover:opacity-90\"\n        >\n          \355\216\230\353\245\264\354\206\214\353\202\230 \353\235\274\354\235\264\355\204\260 \354\212\244\355\212\234\353\224\224\354\230\244\n        </div>\n        <nav className=\"hidden md:flex gap-6 items-center h-full pt-1\">\n          <button\n            onClick={() => onChangeTab(\'archive\')}\n            className={`font-semibold text-body-md h-full px-2 transition-colors border-b-2 py-4 ${\n              currentTab === \'archive\'\n                ? \'text-primary border-primary font-bold\'\n                : \'text-on-surface-variant border-transparent hover:text-primary\'\n            }`}\n          >\n            \354\225\204\354\271\264\354\235\264\353\270\214\n          </button>\n          <button\n            onClick={() => onChangeTab(\'comparison\')}\n            className={`font-semibold text-body-md h-full px-2 transition-colors border-b-2 py-4 ${\n              currentTab === \'comparison\'\n                ? \'text-primary border-primary font-bold\'\n                : \'text-on-surface-variant border-transparent hover:text-primary\'\n            }`}\n          >\n            \355\217\211\352\260\200 \353\214\200\354\213\234\353\263\264\353\223\234\n          </button>\n          <button\n            onClick={() => onChangeTab(\'editor\')}\n            className={`font-semibold text-body-md h-full px-2 transition-colors border-b-2 py-4 ${\n              currentTab === \'editor\'\n                ? \'text-primary border-primary font-bold\'\n                : \'text-on-surface-variant border-transparent hover:text-primary\'\n            }`}\n          >\n            LoRA \353\235\274\354\235\264\353\270\214\353\237\254\353\246\254 (\354\247\221\355\225\204)\n          </button>\n        </nav>\n      </div>\n\n      <div className=\"flex items-center gap-4\">\n        <button \n          onClick={onNewDraft}\n          className=\"bg-primary text-on-primary font-medium px-4 py-2 rounded text-sm hover:bg-opacity-90 transition-all flex items-center gap-2 cursor-pointer\"\n        >\n          <span>\354\203\210 \354\233\220\352\263\240</span>\n        </button>\n        <div className=\"flex items-center gap-2 text-on-surface-variant\">\n          <button className=\"hover:text-primary transition-colors p-1.5 rounded-full hover:bg-surface-container-low\">\n            <User size={18} />\n          </button>\n          <button className=\"hover:text-primary transition-colors p-1.5 rounded-full hover:bg-surface-container-low\">\n            <Settings size={18} />\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n}"
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { BookOpen, HelpCircle, Settings, User } from \"lucide-react\";\n\ninterface HeaderProps {\n  currentTab: \'landing\' | \'editor\' | \'archive\' | \'comparison\';\n  onChangeTab: (tab: \'landing\' | \'editor\' | \'archive\' | \'comparison\') => void;\n  onNewDraft: () => void;\n}\n\nexport default function Header({ currentTab, onChangeTab, onNewDraft }: HeaderProps) {\n  return (\n    <header className=\"bg-bg-warm border-b border-border-warm flex justify-between items-center px-margin-page h-16 w-full fixed top-0 z-50\">\n      <div className=\"flex items-center gap-10\">\n        <div \n          onClick={() => onChangeTab(\'landing\')}\n          className=\"font-serif italic text-xl text-primary cursor-pointer tracking-tight hover:opacity-90 font-semibold\"\n        >\n          Persona Writer\n        </div>\n        <nav className=\"hidden md:flex gap-8 items-center h-full\">\n          <button\n            onClick={() => onChangeTab(\'archive\')}\n            className={`text-[10px] font-bold tracking-[0.3em] h-full transition-colors uppercase py-5 leading-none select-none border-b ${\n              currentTab === \'archive\'\n                ? \'text-primary border-primary\'\n                : \'text-on-surface-variant border-transparent hover:text-primary\'\n            }`}\n          >\n            \354\225\204\354\271\264\354\235\264\353\270\214\n          </button>\n          <button\n            onClick={() => onChangeTab(\'comparison\')}\n            className={`text-[10px] font-bold tracking-[0.3em] h-full transition-colors uppercase py-5 leading-none select-none border-b ${\n              currentTab === \'comparison\'\n                ? \'text-primary border-primary\'\n                : \'text-on-surface-variant border-transparent hover:text-primary\'\n            }`}\n          >\n            \355\217\211\352\260\200 \353\214\200\354\213\234\353\263\264\353\223\234\n          </button>\n          <button\n            onClick={() => onChangeTab(\'editor\')}\n            className={`text-[10px] font-bold tracking-[0.3em] h-full transition-colors uppercase py-5 leading-none select-none border-b ${\n              currentTab === \'editor\'\n                ? \'text-primary border-primary\'\n                : \'text-on-surface-variant border-transparent hover:text-primary\'\n            }`}\n          >\n            LORA \353\235\274\354\235\264\353\270\214\353\237\254\353\246\254 (\354\247\221\355\225\204)\n          </button>\n        </nav>\n      </div>\n\n      <div className=\"flex items-center gap-6\">\n        <button \n          onClick={onNewDraft}\n          className=\"border border-primary text-primary text-[10px] uppercase tracking-[0.2em] font-bold px-5 py-2.5 transition-colors cursor-pointer hover:bg-primary hover:text-on-primary bg-transparent\"\n        >\n          \354\203\210 \354\233\220\352\263\240 \354\236\221\354\204\261\n        </button>\n        <div className=\"flex items-center gap-3 text-on-surface-variant border-l border-border-warm pl-4\">\n          <button className=\"hover:text-primary transition-colors p-1.5 hover:bg-surface-warm rounded\">\n            <User size={15} />\n          </button>\n          <button className=\"hover:text-primary transition-colors p-1.5 hover:bg-surface-warm rounded\">\n            <Settings size={15} />\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n}"
    }
