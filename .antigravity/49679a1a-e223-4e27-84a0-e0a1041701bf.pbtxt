e-pre-wrap\">\n              {contentA}\n            </div>\n          </div>\n\n          {/* Persona 2 Output (Novel) */}\n          <div className=\"bg-surface-dark rounded-lg border border-outline/30 flex flex-col overflow-hidden max-h-[500px]\">\n            <div className=\"p-4 border-b border-outline/30 bg-panel-dark flex justify-between items-center\">\n              <div className=\"flex items-center gap-3\">\n                <span className=\"text-primary-fixed-dim\">\360\237\223\232</span>\n                <h3 className=\"font-sans text-lg font-bold text-inverse-on-surface\">{modelB.name}</h3>\n              </div>\n              <span className=\"px-2 py-1 bg-surface-dark border border-primary-fixed-dim text-primary-fixed-dim font-mono text-[10px] rounded\">\n                LORA: {modelB.loraAdapter}\n              </span>\n            </div>\n            <div className=\"p-6 overflow-y-auto flex-1 font-serif text-base text-outline-variant leading-relaxed select-all whitespace-pre-wrap\">\n              {contentB}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Right Column Evaluation Panel (Dark precise style) */}\n      <aside className=\"w-eval-panel-width bg-surface-dark border-l border-outline/20 p-6 flex flex-col gap-8 h-full overflow-y-auto text-outline-variant\">\n        \n        {/* Appraisal details */}\n        <div>\n          <h3 className=\"font-mono text-xs text-secondary mb-4 flex items-center gap-2\">\n            <Terminal size={14} className=\"text-secondary\" /> \n            \355\217\211\352\260\200 \354\247\200\355\221\234 (\354\242\205\355\225\251 \353\214\200\354\241\260)\n          </h3>\n          \n          <div className=\"space-y-6\">\n            <div>\n              <div className=\"flex justify-between mb-2 text-xs font-mono\">\n                <span>\354\212\244\355\203\200\354\235\274 \354\235\274\352\264\200\354\204\261</span>\n                <span className=\"text-secondary\">{metr