ba(47,166,106,0.5)]\"></span>\n              <span className=\"font-sans text-[10px] text-outline-variant\">\355\216\230\353\245\264\354\206\214\353\202\230 \354\230\244\354\227\274\353\217\204</span>\n              <span className=\"font-mono text-xs text-success mt-1 font-bold\">\353\202\256\354\235\214</span>\n            </div>\n\n            <div className=\"bg-panel-dark p-3 rounded border border-outline/20 flex flex-col items-center justify-center text-center\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-warning mb-2 shadow-[0_0_8px_rgba(217,154,53,0.5)]\"></span>\n              <span className=\"font-sans text-[10px] text-outline-variant\">\355\201\264\353\246\254\354\205\260 \353\260\200\353\217\204</span>\n              <span className=\"font-mono text-xs text-warning mt-1 font-bold\">\353\263\264\355\206\265</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Diagnostics Log Console Terminal */}\n        <div className=\"mt-auto\">\n          <h3 className=\"font-mono text-xs text-secondary mb-3\">\354\247\204\353\213\250 \353\241\234\352\267\270</h3>\n          <div className=\"bg-panel-dark rounded p-3 font-mono text-[10px] text-outline leading-loose border border-outline/20 h-40 overflow-y-auto whitespace-pre-wrap select-all\">\n            {logs.map((log, i) => (\n              <div key={i} className=\"mb-1 text-outline-variant\">\n                {log}\n              </div>\n            ))}\n          </div>\n        </div>\n      </aside>\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"flex-1 ml-0 md:ml-sidebar-width bg-bg-warm h-[calc(100vh-64px)] flex overflow-hidden\">\n      \n      {/* Main Comparison Canvas */}\n      <div className=\"flex-1 p-margin-page flex flex-col gap-6 overflow-y-auto font-sans text-on-surface\">\n        <header className=\"flex justify-between items-end mb-4 border-b border-border-warm pb-4\">\n          <div>\n            <span className=\"text-[9px] font-mono tracking-[0.4em] text-secondary uppercase font-bold\">PARALLEL EXPERIMENT</span>\n            <h1 className=\"font-serif italic text-3xl text-ink mt-1 font-semibold\">\353\214\200\354\241\260 \353\266\204\354\204\235</h1>\n            <p className=\"font-mono text-[9px] text-muted-text mt-2 tracking-wider uppercase\">\n              RUN_ID: 8847-EVAL-X // CONF: TWO_COMPANIONS_V2\n            </p>\n          </div>\n          <div className=\"flex gap-4\">\n            <button \n              onClick={handleExport}\n              className=\"px-4 py-2.5 border border-primary text-primary font-bold text-[10px] uppercase tracking-widest rounded-none hover:bg-primary hover:text-on-primary transition-colors cursor-pointer flex items-center gap-2 bg-transparent\"\n            >\n              {exportSuccess ? <Check size={12} /> : <Download size={12} />}\n              <span>\353\215\260\354\235\264\355\204\260 \353\202\264\353\263\264\353\202\264\352\270\260</span>\n            </button>\n          </div>\n        </header>\n\n        {/* Dynamic Prompt Trigger for Parallel Comparison */}\n        <div className=\"bg-[#121212] p-4 rounded-none border border-border-warm flex gap-4 items-center\">\n          <input \n            value={prompt}\n            onChange={(e) => setPrompt(e.target.value)}\n            className=\"flex-1 bg-[#1A1A1A] text-on-surface border border-border-warm focus:outline-none focus:border-secondary p-3 rounded-none font-sans text-xs placeholder-muted-text\"\n            placeholder=\"\353\217\231\354\235\274\355\225\234 \355\224\204\353\241\254\355\224\204\355\212\270\353\241\234 \354\227\254\353\237\254 \355\216\230\353\245\264\354\206\214\353\202\230\354\235\230 \353\217\231\354\213\234 \354\260\275\354\236\221\354\235\204 \353\271\204\352\265\220\355\225\264 \353\263\264\354\204\270\354\232\224...\"\n          />\n          <button \n            disabled={isComparing || !prompt.trim()}\n            onClick={handleCompareGenerate}\n            className={`border border-[#3A3A3A] text-on-surface hover:text-primary hover:border-primary text-[10px] font-bold tracking-[0.2em] px-5 py-3 uppercase transition-all bg-transparent rounded-none cursor-pointer ${\n              (isComparing || !prompt.trim()) ? \"opacity-50 cursor-not-allowed\" : \"\"\n            }`}\n          >\n            <ArrowLeftRight size={12} className={isComparing ? \"animate-spin\" : \"\"} />\n            <span>{isComparing ? \"LORA SYNCHRONIZING...\" : \"\353\214\200\354\241\260 \354\260\275\354\236\221 \354\213\234\354\236\221\"}</span>\n          </button>\n        </div>\n\n        {/* 2-Columns grid representing model outputs */}\n        <div className=\"grid grid-cols-1 xl:grid-cols-2 gap-gutter h-full\">\n          \n          {/* Persona 1 Output (Movie) */}\n          <div className=\"bg-surface-warm rounded-none border border-border-warm flex flex-col overflow-hidden max-h-[500px]\">\n            <div className=\"p-4 border-b border-border-warm bg-[#0D0D0D] flex justify-between items-center\">\n              <div className=\"flex items-center gap-3\">\n                <span className=\"text-secondary text-sm\">\342\234\246</span>\n                <h3 className=\"font-serif italic text-base text-ink font-semibold\">{modelA.name}</h3>\n              </div>\n              <span className=\"px-2.5 py-1 bg-transparent border border-border-warm text-on-surface-variant font-mono text-[9px] uppercase tracking-widest rounded-none\">\n                {modelA.loraAdapter}\n              </span>\n            </div>\n            <div className=\"p-6 overflow-y-auto flex-1 font-serif text-sm text-on-surface leading-loose select-all whitespace-pre-wrap\">\n              {contentA}\n            </div>\n          </div>\n\n          {/* Persona 2 Output (Novel) */}\n          <div className=\"bg-surface-warm rounded-none border border-border-warm flex flex-col overflow-hidden max-h-[500px]\">\n            <div className=\"p-4 border-b border-border-warm bg-[#0D0D0D] flex justify-between items-center\">\n              <div className=\"flex items-center gap-3\">\n                <span className=\"text-secondary text-sm\">\342\234\246</span>\n                <h3 className=\"font-serif italic text-base text-ink font-semibold\">{modelB.name}</h3>\n              </div>\n              <span className=\"px-2.5 py-1 bg-transparent border border-border-warm text-on-surface-variant font-mono text-[9px] uppercase tracking-widest rounded-none\">\n                {modelB.loraAdapter}\n              </span>\n            </div>\n            <div className=\"p-6 overflow-y-auto flex-1 font-serif text-sm text-on-surface leading-loose select-all whitespace-pre-wrap\">\n              {contentB}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Right Column Evaluation Panel (Dark precise style) */}\n      <aside className=\"w-eval-panel-width bg-panel-dark border-l border-[#202020] p-6 flex flex-col gap-8 h-full overflow-y-auto text-on-surface\">\n        \n        {/* Appraisal details */}\n        <div>\n          <h3 className=\"font-mono text-[9px] tracking-[0.3em] font-bold text-secondary mb-5 flex items-center gap-2 uppercase\">\n            <Terminal size={12} className=\"text-secondary\" /> \n            EVALUATION SCORE DUET\n          </h3>\n          \n          <div className=\"space-y-5\">\n            <div>\n              <div className=\"flex justify-between mb-1.5 text-[10px] font-mono grayscale opacity-90\">\n                <span>STYLE CONSISTENCY</span>\n                <span className=\"text-secondary font-bold\">{metricStyle}%</span>\n              </div>\n              <div className=\"w-full bg-[#1A1A1A] h-[2px] overflow-hidden\">\n                <div className=\"bg-white h-full transition-all duration-500\" style={{ width: `${metricStyle}%` }}></div>\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex justify-between mb-1.5 text-[10px] font-mono grayscale opacity-90\">\n                <span>GENRE COMPLIANCE</span>\n                <span className=\"text-secondary font-bold\">{metricGenre}%</span>\n              </div>\n              <div className=\"w-full bg-[#1A1A1A] h-[2px] overflow-hidden\">\n                <div className=\"bg-white h-full transition-all duration-500\" style={{ width: `${metricGenre}%` }}></div>\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex justify-between mb-1.5 text-[10px] font-mono grayscale opacity-90\">\n                <span>PACING FLOW</span>\n                <span className=\"text-on-surface font-bold\">{metricPacing}%</span>\n              </div>\n              <div className=\"w-full bg-[#1A1A1A] h-[2px] overflow-hidden\">\n                <div className=\"bg-white h-full transition-all duration-500\" style={{ width: `${metricPacing}%` }}></div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Risk Indicators */}\n        <div>\n          <h3 className=\"font-mono text-[9px] tracking-[0.3em] font-bold text-secondary mb-4 flex items-center gap-2 uppercase\">\n            <AlertTriangle size={12} className=\"text-secondary\" />\n            LORA COMPLIANCE RISKS\n          </h3>\n\n          <div className=\"grid grid-cols-2 gap-3 font-mono text-[10px]\">\n            <div className=\"bg-[#0A0A0A] p-3 rounded-none border border-border-warm flex flex-col items-center justify-center text-center\">\n              <span className=\"w-1.5 h-1.5 bg-success mb-2\"></span>\n              <span className=\"text-[9px] text-on-surface-variant uppercase tracking-wider\">CONTAMINATION</span>\n              <span className=\"text-xs text-success mt-1 font-bold uppercase\">LOW</span>\n            </div>\n\n            <div className=\"bg-[#0A0A0A] p-3 rounded-none border border-border-warm flex flex-col items-center justify-center text-center\">\n              <span className=\"w-1.5 h-1.5 bg-warning mb-2\"></span>\n              <span className=\"text-[9px] text-on-surface-variant uppercase tracking-wider\">CLICH\303\211 INDEX</span>\n              <span className=\"text-xs text-warning mt-1 font-bold uppercase\">MID</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Diagnostics Log Console Terminal */}\n        <div className=\"mt-auto flex flex-col\">\n          <h3 className=\"font-mono text-[9px] tracking-[0.3em] font-bold text-secondary mb-3 uppercase\">\354\247\204\353\213\250 \354\213\244\354\213\234\352\260\204 \353\241\234\352\267\270</h3>\n          <div className=\"bg-[#070707] rounded-none p-3.5 font-mono text-[10px] leading-relaxed text-on-surface-variant border border-border-warm h-44 overflow-y-auto whitespace-pre-wrap select-all\">\n            {logs.map((log, i) => (\n              <div key={i} className=\"mb-1 text-muted-text\">\n                {log}\n              </div>\n            ))}\n          </div>\n        </div>\n      </aside>\n    </div>\n  );"
