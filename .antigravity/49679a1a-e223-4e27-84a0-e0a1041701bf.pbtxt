    replacement_chunks {
      target_content: "@import \"tailwindcss\";\n\n@theme {\n  /* Fonts Pairing Strategy */\n  --font-sans: \"Pretendard\", \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n\n  /* Custom Color System for Persona Editorial Studio */\n  --color-primary: #9a4021; /* Terracotta Primary Accent */\n  --color-on-primary: #ffffff;\n  --color-primary-container: #fdeae4;\n  --color-on-primary-container: #9a4021;\n  --color-primary-fixed-dim: #ffb59d;\n\n  --color-secondary: #5450bd; /* Indigo-violet Secondary Accent */\n  --color-on-secondary: #ffffff;\n  --color-secondary-container: #e2dfff;\n  --color-on-secondary-container: #271d8f;\n\n  --color-tertiary: #006768;\n  --color-on-tertiary: #ffffff;\n  --color-tertiary-fixed: #89f4f4;\n  --color-tertiary-fixed-dim: #6cd7d8;\n\n  --color-bg-warm: #F5F2EA; /* Background Warm Paper */\n  --color-surface-warm: #FAF8F1; /* Soft Surface Warm Tint */\n  --color-border-warm: #E8E1D4; /* Light Card Borders */\n  \n  --color-ink: #141413; /* Ink Pitch-Black Heading Text */\n  --color-on-surface: #231916; /* Primary Slate Ink Body Text */\n  --color-on-surface-variant: #56423c; /* Semi-muted labels */\n  --color-muted-text: #6F6B63; /* Low-priority captions */\n  --color-outline: #89726b; /* Semi-high borders */\n  --color-outline-variant: #dcc1b8; /* Soft borders */\n  \n  --color-panel-dark: #0F1011; /* Precise Eval Dashboard Deep Black bg */\n  --color-surface-dark: #191A1B; /* Precise Dashboard Surface Dark */\n  \n  --color-success: #2FA66A; /* True-green indicator */\n  --color-warning: #D99A35;\n\n  /* Spacing Grid */\n  --spacing-sidebar-width: 280px;\n  --spacing-eval-panel-width: 320px;\n  --spacing-gutter: 1.5rem;\n  --spacing-margin-page: 2rem;\n  --spacing-stack-gap: 1rem;\n}\n\nbody {\n  font-family: var(--font-sans);\n  background-color: var(--color-bg-warm);\n  color: var(--color-on-surface);\n  -webkit-font-smoothing: antialiased;\n}\n\n/* Scrollbar Style for Precision evaluation dark panel */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n::-webkit-scrollbar-thumb {\n  background: var(--color-outline);\n  border-radius: 3px;\n  opacity: 0.5;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: var(--color-primary);\n}"
      replacement_content: "@import \"tailwindcss\";\n\n@theme {\n  /* Fonts Pairing Strategy */\n  --font-sans: \"Pretendard\", \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  --font-serif: \"Playfair Display\", Georgia, serif; /* Elegant serif typeface */\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n\n  /* Custom Color System for Persona Editorial Studio (Dark Minimal Editorial Theme) */\n  --color-primary: #FFFFFF; /* High-Contrast Editorial White */\n  --color-on-primary: #0F0F0F; /* Sleek Dark Slate for contrasts */\n  --color-primary-container: #2A2A2A;\n  --color-on-primary-container: #F5F5F5;\n  --color-primary-fixed-dim: #CCCCCC;\n\n  --color-secondary: #C0A080; /* Premium Autumn biscuit/bronze accent */\n  --color-on-secondary: #0F0F0F;\n  --color-secondary-container: #222222;\n  --color-on-secondary-container: #C0A080;\n\n  --color-tertiary: #A0A0A0; /* Clean editorial mid-gray */\n  --color-on-tertiary: #0F0F0F;\n  --color-tertiary-fixed: #EAEAEA;\n  --color-tertiary-fixed-dim: #A0A0A0;\n\n  --color-bg-warm: #0F0F0F; /* Deep Dark Minimal canvas */\n  --color-surface-warm: #151515; /* Symmetrical Dark Surfaces */\n  --color-border-warm: #2A2A2A; /* Tactile crisp dark border lines */\n  \n  --color-ink: #FFFFFF; /* Perfect stark caption and display headers */\n  --color-on-surface: #F5F5F5; /* Main bright off-white reading text */\n  --color-on-surface-variant: #A0A0A0; /* Beautiful structural meta descriptors */\n  --color-muted-text: #666666; /* Quiet low-priority notes */\n  --color-outline: #3A3A3A; /* Slightly prominent borders or dividers */\n  --color-outline-variant: #2A2A2A; /* Dynamic gridlines */\n  \n  --color-panel-dark: #0A0A0A; /* Deeper black for comparison dashboards */\n  --color-surface-dark: #121212;\n  \n  --color-success: #3EAF76; /* Sophisticated sage teal success indicator */\n  --color-warning: #D99A35;\n\n  /* Spacing Grid */\n  --spacing-sidebar-width: 280px;\n  --spacing-eval-panel-width: 320px;\n  --spacing-gutter: 1.5rem;\n  --spacing-margin-page: 2rem;\n  --spacing-stack-gap: 1rem;\n}\n\nbody {\n  font-family: var(--font-sans);\n  background-color: var(--color-bg-warm);\n  color: var(--color-on-surface);\n  -webkit-font-smoothing: antialiased;\n}\n\n/* Scrollbar Style for Precision evaluation dark panel */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n::-webkit-scrollbar-thumb {\n  background: var(--color-outline);\n  border-radius: 3px;\n  opacity: 0.5;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: var(--color-primary);\n}"
    }
    instruction: "Update the custom color system inside CSS @theme to match the Editorial Aesthetic with dark background colors, crisp white/gray editorial text contrast, elegant serif configurations, and subtle borders."
  }
}
