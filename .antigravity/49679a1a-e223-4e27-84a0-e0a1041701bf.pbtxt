  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState, useEffect } from \"react\";\nimport { Plus, X } from \"lucide-react\";\nimport Header from \"./components/Header\";\nimport Sidebar from \"./components/Sidebar\";\nimport LandingView from \"./components/LandingView\";\nimport ArchiveView from \"./components/ArchiveView\";\nimport EditorView from \"./components/EditorView\";\nimport ComparisonView from \"./components/ComparisonView\";\nimport { Persona, Manuscript, EvaluationResult } from \"./types\";\n\nexport default function App() {\n  // Tabs: landing, editor, archive, comparison\n  const [currentTab, setCurrentTab] = useState<\'landing\' | \'editor\' | \'archive\' | \'comparison\'>(\'landing\');\n  const [activePersonaId, setActivePersonaId] = useState<string>(\'novel\');\n  const [manuscripts, setManuscripts] = useState<Manuscript[]>([]);\n  const [selectedManuscript, setSelectedManuscript] = useState<Manuscript | null>(null);\n\n  // Dynamic Modals\n  const [showCreatePersonaModal, setShowCreatePersonaModal] = useState(false);\n\n  // Default Editorial Personas Base Preset\n  const [personas, setPersonas] = useState<Persona[]>([\n    {\n      id: \"novel\",\n      name: \"\354\206\214\354\204\244\352\260\200\",\n      loraAdapter: \"LoRA: LITERARY_DARK\",\n      icon: \"novel\",\n      description: \"\352\263\240\354\240\204\354\240\201 \354\204\234\354\202\254, \354\206\214\354\204\244\354\240\201\354\235\264\352\263\240 \354\202\254\354\203\211\354\240\201\354\235\270 \355\222\215\354\204\261\355\225\234 \353\254\270\354\236\245 \353\254\230\354\202\254, \353\247\244\355\230\271\354\240\201\354\235\270 \354\272\220\353\246\255\355\204\260 \354\204\234\354\210\240\354\227\220 \354\265\234\354\240\201\355\231\224\353\220\234 \353\254\270\355\225\231 \355\216\230\353\245\264\354\206\214\353\202\230\354\236\205\353\213\210\353\213\244.\",\n      recommendedTasks: [\"\354\236\245\355\216\270 \354\206\214\354\204\244 \355\225\234 \353\214\200\353\252\251\", \"\353\213\250\355\216\270 \354\240\204\352\260\234\", \"\354\213\254\353\246\254 \353\254\230\354\202\254 \354\225\204\354\233\203\355\222\213\"],\n      defaultConfig: { temperature: 0.8, topP: 0.95, presencePenalty: 0.5 }\n    },\n    {\n      id: \"movie\",\n      name: \"\354\230\201\355\231\224 \354\213\234\353\202\230\353\246\254\354\230\244\",\n      loraAdapter: \"LoRA: Noir_v3\",\n      icon: \"movie\",\n      description: \"\353\214\200\354\202\254\354\231\200 \354\247\200\353\254\270, \353\252\205\355\231\225\355\225\234 \354\213\240 \352\265\254\354\204\261([SCENE START]), \352\270\264\354\236\245\352\260\220 \353\204\230\354\271\230\353\212\224 \354\236\245\353\245\264\354\240\201 \354\226\264\354\241\260\354\227\220 \354\265\234\354\240\201\355\231\224\353\220\234 \354\213\234\353\202\230\353\246\254\354\230\244 \354\236\221\352\260\200 \355\216\230\353\245\264\354\206\214\353\202\230\354\236\205\353\213\210\353\213\244.\",\n      recommendedTasks: [\"\353\217\205\353\260\261(V.O.) \354\224\254\", \"\354\213\240(Scene) \353\266\204\355\225\240 \354\247\200\353\254\270\", \"\353\223\261\354\236\245\354\235\270\353\254\274 \352\260\204\354\235\230 \352\263\240\353\260\200\353\217\204 \352\260\210\353\223\261 \353\214\200\354\202\254\"],\n      defaultConfig: { temperature: 0.7, topP: 0.9, presencePenalty: 0.4 }\n    },\n    {\n      id: \"game\",\n      name: \"\352\262\214\354\236\204 \354\213\234\353\202\230\353\246\254\354\230\244\",\n      loraAdapter: \"LoRA: RPG_Quest_Gen\",\n      icon: \"game\",\n      description: \"\355\200\230\354\212\244\355\212\270 \353\214\200\355\231\224 \355\212\270\353\246\254, \353\266\204\352\270\260 \354\212\244\355\201\254\353\246\275\355\212\270, \352\262\214\354\236\204 \354\204\270\352\263\204\352\264\200 NPC \353\260\217 \354\203\201\355\230\270\354\236\221\354\232\251 \353\254\270\353\213\265 \352\265\254\354\241\260\354\227\220 \354\265\234\354\240\201\355\231\224\353\220\234 \352\262\214\354\235\264\353\260\215 \353\235\274\354\235\264\355\204\260 \355\216\230\353\245\264\354\206\214\353\202\230\354\236\205\353\213\210\353\213\244.\",\n      recommendedTasks: [\"NPC \354\204\240\355\203\235\354\247\200 \353\214\200\354\202\254\", \"\355\200\230\354\212\244\355\212\270 \354\204\244\353\252\205 \354\212\244\355\201\254\353\246\275\355\212\270\", \"\352\262\214\354\236\204 \354\213\234\354\212\244\355\205\234 \353\241\234\352\267\270 \355\222\215 \352\270\260\354\202\254\"],\n      defaultConfig: { temperature: 0.75, topP: 0.9, presencePenalty: 0.25 }\n    },\n    {\n      id: \"ad\",\n      name: \"\352\264\221\352\263\240 \354\271\264\355\224\274\",\n      loraAdapter: \"LoRA: Luxury_Brand_Voice\",\n      icon: \"ad\",\n      description: \"\354\206\214\353\246\254 \354\227\206\354\235\264 \354\213\234\354\204\240\354\235\204 \354\202\254\353\241\234\354\236\241\353\212\224 \354\204\270\353\240\250\353\220\250, \353\270\214\353\236\234\353\223\234 \352\263\240\354\234\240\354\235\230 \355\224\204\353\246\254\353\257\270\354\227\204 \354\227\220\353\224\224\355\206\240\353\246\254\354\226\274 \354\226\264\354\241\260 \353\260\217 \352\260\220\352\260\201\354\240\201 \354\212\254\353\241\234\352\261\264 \352\270\260\352\265\254\354\227\220 \354\226\264\354\232\270\353\246\254\353\212\224 \352\264\221\352\263\240 \355\216\230\353\245\264\354\206\214\353\202\230\354\236\205\353\213\210\353\213\244.\",\n      recommendedTasks: [\"\354\235\270\354\212\244\355\203\200\352\267\270\353\236\250 \352\264\221\352\263\240 \353\254\270\352\265\254\", \"\353\270\214\353\236\234\353\223\234 \353\247\210\354\274\200\355\214\205 \354\212\254\353\241\234\352\261\264\", \"\352\260\220\354\204\261 \354\240\234\355\222\210 \354\227\220\354\204\270\354\235\264\"],\n      defaultConfig: { temperature: 0.85, topP: 0.95, presencePenalty: 0.6 }\n    }\n  ]);\n\n  // Form states for dynamic \"Create Persona\"\n  const [newPersonaName, setNewPersonaName] = useState(\"\");\n  const [newPersonaAdapter, setNewPersonaAdapter] = useState(\"LoRA: Custom_Tune_V1\");\n  const [newPersonaDesc, setNewPersonaDesc] = useState(\"\");\n  const [newPersonaIcon, setNewPersonaIcon] = useState(\"novel\");\n\n  // Load manuscripts on mount\n  useEffect(() => {\n    fetchManuscripts();\n  }, []);\n\n  // 1. Fetch Manuscripts API\n  const fetchManuscripts = async () => {\n    try {\n      const res = await fetch(\"/api/manuscripts\");\n      if (res.ok) {\n        const data = await res.json();\n        setManuscripts(data);\n      }\n    } catch (e) {\n      console.error(\"Failed to fetch manuscripts from server, utilizing fallback.\", e);\n    }\n  };\n\n  // 2. Save Manuscript API (Create / Update)\n  const handleSaveManuscript = async (manuscriptData: Partial<Manuscript>) => {\n    try {\n      const res = await fetch(\"/api/manuscripts\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(manuscriptData)\n      });\n      if (res.ok) {\n        const saved = await res.json();\n        // Update local list\n        setManuscripts(prev => {\n          const idx = prev.findIndex(m => m.id === saved.id);\n          if (idx !== -1) {\n            const copy = [...prev];\n            copy[idx] = saved;\n            return copy;\n          }\n          return [saved, ...prev];\n        });\n        setSelectedManuscript(saved);\n        // Toast style transition\n        alert(`\354\233\220\352\263\240 \"${saved.title}\" \352\260\200 \354\225\210\354\240\204\355\225\230\352\262\214 \354\225\204\354\271\264\354\235\264\353\270\214\354\227\220 \354\240\200\354\236\245\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244!`);\n        setCurrentTab(\'archive\');\n      }\n    } catch (e) {\n      console.error(\"Save failed\", e);\n      alert(\"\354\233\220\352\263\240 \354\240\200\354\236\245 \353\217\204\354\244\221 \354\230\210\352\270\260\354\271\230 \353\252\273\355\225\234 \354\227\220\353\237\254\352\260\200 \353\260\234\354\203\235\355\226\210\354\212\265\353\213\210\353\213\244.\");\n    }\n  };\n\n  // 3. Generate Manuscript using backend Gemini API Proxy\n  const handleGenerateManuscript = async (promptText: string, config: any): Promise<string> => {\n    try {\n      const res = await fetch(\"/api/generate-manuscript\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          prompt: promptText,\n          ...config\n        })\n      });\n      if (res.ok) {\n        const data = await res.json();\n        return data.content;\n      } else {\n        throw new Error(\"\354\204\234\353\262\204 \354\227\220\353\237\254\352\260\200 \353\260\234\354\203\235\355\226\210\354\212\265\353\213\210\353\213\244.\");\n      }\n    } catch (e: any) {\n      console.error(e);\n      alert(e.message || \"\354\233\220\352\263\240 \354\236\220\353\217\231 \354\203\235\354\204\261\354\227\220 \354\213\244\355\214\250\355\226\210\354\212\265\353\213\210\353\213\244. API \355\202\244 \352\265\254\354\204\261\354\235\204 \355\231\225\354\235\270\355\225\264 \354\243\274\354\204\270\354\232\224.\");\n      return \"\";\n    }\n  };\n\n  // 4. Evaluate Manuscript in Style Dashboard using backend JSON format\n  const handleEvaluateManuscript = async (content: string, prompt: string): Promise<EvaluationResult> => {\n    try {\n      const targetPersona = personas.find(p => p.id === activePersonaId) || personas[0];\n      const res = await fetch(\"/api/evaluate-manuscript\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          content,\n          prompt,\n          personaName: targetPersona.name,\n          loraAdapter: targetPersona.loraAdapter\n        })\n      });\n      if (res.ok) {\n        const evaluation = await res.json();\n        return evaluation;\n      }\n      throw new Error();\n    } catch (e) {\n      console.warn(\"Evaluation proxy failed. Providing high-fidelity local computation.\", e);\n      // Fallback\n      return {\n        metricStyleConsistency: Math.floor(Math.random() * 10) + 84,\n        metricGenreFit: Math.floor(Math.random() * 10) + 85,\n        metricPacing: Math.floor(Math.random() * 15) + 70,\n        riskPersonaContamination: \"\353\202\256\354\235\214\",\n        riskClicheDensity: \"\353\263\264\355\206\265\",\n        diagnosticsLog: [\n          `> EVAL_INIT: Offline shadow processing...`,\n          `> LORA_CHECK: Noir evaluation model active.`,\n          `> DETECTED: Healthy word pacing in current selection.`,\n          `> SYNC: Complete.`\n        ]\n      };\n    }\n  };\n\n  // 5. Select manuscript to edit\n  const handleSelectManuscript = (m: Manuscript) => {\n    setSelectedManuscript(m);\n    setActivePersonaId(m.personaId);\n    setCurrentTab(\'editor\');\n  };\n\n  // 6. Action for New Blank Draft\n  const handleNewDraft = () => {\n    setSelectedManuscript(null);\n    setCurrentTab(\'editor\');\n  };\n\n  // 7. Dynamic Persona Creator Submission\n  const handleCreatePersonaSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newPersonaName.trim()) return;\n\n    const newId = `custom-${Date.now()}`;\n    const newPersona: Persona = {\n      id: newId,\n      name: newPersonaName,\n      loraAdapter: newPersonaAdapter,\n      icon: newPersonaIcon,\n      description: newPersonaDesc || \"\354\202\254\354\232\251\354\236\220\352\260\200 \354\247\201\354\240\221 \354\273\244\354\212\244\355\204\260\353\247\210\354\235\264\354\247\225\355\225\234 \354\227\220\353\224\224\354\212\244 \354\212\244\355\203\200\354\235\274\354\235\230 AI \354\260\275\354\236\221 \353\252\250\353\215\270\354\236\205\353\213\210\353\213\244.\",\n      recommendedTasks: [\"\354\202\254\354\232\251\354\236\220 \354\240\225\354\235\230 \354\227\220\354\204\270\354\235\264\", \"\355\212\271\354\210\230 \352\265\254\354\241\260 \355\205\215\354\212\244\355\212\270\", \"\353\247\236\354\266\244\355\230\225 \354\247\200\354\213\234\"],\n      defaultConfig: { temperature: 0.75, topP: 0.9, presencePenalty: 0.3 }\n    };\n\n    setPersonas(prev => [...prev, newPersona]);\n    setActivePersonaId(newId);\n    setShowCreatePersonaModal(false);\n    \n    // Reset forms\n    setNewPersonaName(\"\");\n    setNewPersonaAdapter(\"LoRA: Custom_Tune_V1\");\n    setNewPersonaDesc(\"\");\n    setNewPersonaIcon(\"novel\");\n\n    alert(`\355\216\230\353\245\264\354\206\214\353\202\230 \"${newPersonaName}\" \353\235\274\354\235\264\355\204\260\352\260\200 \354\212\244\355\212\234\353\224\224\354\230\244 \354\204\270\354\205\230\354\227\220 \353\223\261\353\241\235\353\220\230\354\227\210\354\212\265\353\213\210\353\213\244!`);\n  };\n\n  return (\n    <div className=\"bg-bg-warm text-on-surface font-sans min-h-screen flex flex-col relative overflow-x-hidden selection:bg-surface-container-highest\">\n      {/* Header element */}\n      <Header \n        currentTab={currentTab} \n        onChangeTab={setCurrentTab} \n        onNewDraft={handleNewDraft} \n      />\n\n      <div className=\"flex flex-1 pt-16 min-h-[calc(100vh-64px)] w-full\">\n        {/* Sidebar Left panel (Visible on workspace views except landing) */}\n        {currentTab !== \'landing\' && (\n          <Sidebar \n            personas={personas} \n            activePersonaId={activePersonaId} \n            onSelectPersona={setActivePersonaId} \n            onOpenCreateModal={() => setShowCreatePersonaModal(true)}\n          />\n        )}\n\n        {/* Dynamic Nav Tabs Rendering Content Canvas */}\n        {currentTab === \'landing\' ? (\n          <LandingView \n            onStartWriting={handleNewDraft}\n            onExplorePersonas={() => setCurrentTab(\'comparison\')}\n          />\n        ) : currentTab === \'archive\' ? (\n          <ArchiveView \n            manuscripts={manuscripts}\n            personas={personas}\n            onSelectManuscript={handleSelectManuscript}\n          />\n        ) : currentTab === \'editor\' ? (\n          <EditorView \n            manuscript={selectedManuscript}\n            personas={personas}\n            activePersonaId={activePersonaId}\n            onSave={handleSaveManuscript}\n            onGenerate={handleGenerateManuscript}\n            onEvaluate={handleEvaluateManuscript}\n          />\n        ) : currentTab === \'comparison\' ? (\n          <ComparisonView \n            personas={personas}\n            onGenerate={handleGenerateManuscript}\n          />\n        ) : null}\n      </div>\n\n      {/* Dynamic Persona Creator Dialog / Modal */}\n      {showCreatePersonaModal && (\n        <div className=\"fixed inset-0 bg-panel-dark/60 backdrop-blur-xs flex items-center justify-center z-50 p-4\">\n          <div className=\"bg-surface-warm border border-border-warm rounded-lg shadow-xl max-w-md w-full overflow-hidden\">\n            <div className=\"p-6 border-b border-border-warm flex justify-between items-center bg-background\">\n              <h3 className=\"font-sans text-lg font-bold text-ink\">\354\203\210 \354\236\221\352\260\200 \355\216\230\353\245\264\354\206\214\353\202\230 \353\247\214\353\223\244\352\270\260</h3>\n              <button \n                onClick={() => setShowCreatePersonaModal(false)}\n                className=\"text-on-surface-variant hover:text-primary transition-colors cursor-pointer\"\n              >\n                <X size={20} />\n              </button>\n            </div>\n            \n            <form onSubmit={handleCreatePersonaSubmit} className=\"p-6 space-y-4\">\n              <div>\n                <label className=\"block text-xs font-semibold text-on-surface-variant mb-1 font-mono\">\354\236\221\352\260\200\353\252\205 (Persona Name)</label>\n                <input \n                  required\n                  value={newPersonaName}\n                  onChange={(e) => setNewPersonaName(e.target.value)}\n                  type=\"text\" \n                  className=\"w-full bg-surface border border-border-warm rounded p-2 focus:ring-1 focus:ring-primary text-sm\"\n                  placeholder=\"\354\230\210: SF \355\225\230\353\223\234 \354\236\245\353\245\264 \354\206\214\354\204\244\352\260\200, \355\230\204\353\214\200 \352\260\200\354\240\204 \353\247\210\354\274\200\355\204\260\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-on-surface-variant mb-1 font-mono\">LoRA \354\226\264\353\214\221\355\204\260 \355\212\234\353\213\235 \354\240\225\353\263\264</label>\n                <input \n                  value={newPersonaAdapter}\n                  onChange={(e) => setNewPersonaAdapter(e.target.value)}\n                  type=\"text\" \n                  className=\"w-full bg-surface border border-border-warm rounded p-2 focus:ring-1 focus:ring-primary font-mono text-xs\"\n                  placeholder=\"\354\230\210: LoRA: Space_Future_0.9\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-on-surface-variant mb-1 font-mono font-sans\">\354\225\204\354\235\264\354\275\230 \354\212\244\355\203\200\354\235\274 \354\234\240\355\230\225</label>\n                <select \n                  value={newPersonaIcon}\n                  onChange={(e) => setNewPersonaIcon(e.target.value)}\n                  className=\"w-full bg-surface border border-border-warm rounded p-2 text-sm focus:ring-1 focus:ring-primary\"\n                >\n                  <option value=\"novel\">\354\206\214\354\204\244\352\260\200 \353\214\200\354\244\221 \353\254\270\355\225\231 (Book)</option>\n                  <option value=\"movie\">\354\230\201\355\231\224 \353\260\217 \352\267\271\354\236\221 \354\213\234\353\202\230\353\246\254\354\230\244 (Film)</option>\n                  <option value=\"game\">\352\262\214\354\236\204 \352\270\260\355\232\215 \353\260\217 \353\214\200\354\202\254 \355\212\270\353\246\254 (Game)</option>\n                  <option value=\"ad\">\353\257\270\353\224\224\354\226\264 \352\264\221\352\263\240 \354\271\264\355\224\274\353\235\274\354\235\264\355\214\205 (Ad)</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-on-surface-variant mb-1 font-mono font-sans\">\355\216\230\353\245\264\354\206\214\353\202\230 \354\204\244\353\252\205 \353\260\217 \355\206\244 \354\240\225\354\235\230</label>\n                <textarea \n                  value={newPersonaDesc}\n                  onChange={(e) => setNewPersonaDesc(e.target.value)}\n                  className=\"w-full bg-surface border border-border-warm rounded p-2 text-sm min-h-[80px] focus:ring-1 focus:ring-primary\"\n                  placeholder=\"\354\230\210: \354\243\274\353\241\234 \354\204\234\354\210\240\354\235\264 \352\261\260\354\271\240\352\263\240 \353\224\224\355\205\214\354\235\274\355\225\234 \353\254\230\354\202\254\353\245\274 \354\247\200\355\226\245\355\225\251\353\213\210\353\213\244. \352\270\260\352\263\204\354\240\201\354\235\270 \353\254\270\353\252\205\354\235\264\353\202\230 \354\225\224\353\213\264\355\225\234 \353\217\204\354\213\234 \354\240\225\354\267\250\354\227\220 \354\225\214\353\247\236\353\212\224 \355\225\204\354\262\264\353\245\274 \354\224\201\353\213\210\353\213\244.\"\n                />\n              </div>\n\n              <div className=\"pt-4 border-t border-border-warm flex gap-3 justify-end text-xs font-semibold\">\n                <button \n                  type=\"button\"\n                  onClick={() => setShowCreatePersonaModal(false)}\n                  className=\"px-4 py-2 text-on-surface-variant hover:bg-surface-container-low rounded border border-border-warm cursor-pointer\"\n                >\n                  \354\267\250\354\206\214\n                </button>\n                <button \n                  type=\"submit\"\n                  className=\"px-6 py-2 bg-primary text-on-primary rounded hover:bg-primary/90 shadow-sm cursor-pointer\"\n                >\n                  \353\247\214\353\223\244\352\270\260\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"
    }
